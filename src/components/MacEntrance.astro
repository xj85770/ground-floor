<div id="gf-entrance" class="gf-entrance" role="dialog" aria-label="Ground Floor introduction" aria-modal="true" hidden>
  <canvas id="gf-three-canvas" class="gf-three-canvas" aria-hidden="true"></canvas>
  <button id="gf-entrance-skip" class="gf-entrance-skip" type="button">Skip introduction</button>
  <p class="gf-entrance-kicker" aria-hidden="true">Local hardware. Controlled data path.</p>
  <p class="gf-entrance-handoff" aria-hidden="true">Start with the work.</p>
  <p id="gf-webgl-fallback" class="gf-webgl-fallback" role="status" hidden>Opening the live setup checker…</p>
</div>

<script>
  import * as THREE from 'three';
  import { RoundedBoxGeometry } from 'three/addons/geometries/RoundedBoxGeometry.js';

  const entrance = document.getElementById('gf-entrance') as HTMLDivElement | null;
  const canvas = document.getElementById('gf-three-canvas') as HTMLCanvasElement | null;
  const skip = document.getElementById('gf-entrance-skip') as HTMLButtonElement | null;
  const replay = document.getElementById('gf-replay-entrance');
  const fallback = document.getElementById('gf-webgl-fallback');
  const storageKey = 'gf-entrance-seen-v2';
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const DURATION = 5.1;
  // 16-inch MacBook Pro proportions from Apple's 2026 M5 Pro / M5 Max specs.
  const CHASSIS_WIDTH = 8;
  const CHASSIS_DEPTH = CHASSIS_WIDTH * (24.81 / 35.57);
  const CLOSED_HEIGHT = CHASSIS_WIDTH * (1.68 / 35.57);
  const DISPLAY_ASPECT = 3456 / 2234;

  let renderer: THREE.WebGLRenderer | null = null;
  let scene: THREE.Scene | null = null;
  let camera: THREE.PerspectiveCamera | null = null;
  let laptop: THREE.Group | null = null;
  let lidPivot: THREE.Group | null = null;
  let screenMaterial: THREE.MeshBasicMaterial | null = null;
  let animationFrame = 0;
  let startTime: number | null = null;
  let playing = false;
  let exitStarted = false;

  const clamp01 = (value: number) => Math.max(0, Math.min(1, value));
  const range = (time: number, start: number, end: number) => clamp01((time - start) / (end - start));
  const smooth = (value: number) => value * value * (3 - 2 * value);
  const easeOut = (value: number) => 1 - Math.pow(1 - value, 3);

  function hasSeenEntrance() {
    try { return window.localStorage.getItem(storageKey) === 'true'; }
    catch { return false; }
  }

  function rememberEntrance() {
    try { window.localStorage.setItem(storageKey, 'true'); }
    catch { /* The experience still works when storage is unavailable. */ }
  }

  function createScreenTexture() {
    const screenCanvas = document.createElement('canvas');
    screenCanvas.width = 1800;
    screenCanvas.height = 1100;
    const context = screenCanvas.getContext('2d');
    if (!context) return null;

    context.clearRect(0, 0, screenCanvas.width, screenCanvas.height);
    context.save();
    context.beginPath();
    context.roundRect(0, 0, screenCanvas.width, screenCanvas.height, 58);
    context.clip();
    context.fillStyle = '#f2f4f3';
    context.fillRect(0, 0, screenCanvas.width, screenCanvas.height);
    context.fillStyle = '#ffffff';
    context.fillRect(0, 0, screenCanvas.width, 132);
    context.strokeStyle = '#c8d0d5';
    context.lineWidth = 3;
    context.beginPath();
    context.moveTo(0, 132);
    context.lineTo(screenCanvas.width, 132);
    context.stroke();

    context.fillStyle = '#111820';
    context.font = '600 42px "IBM Plex Sans", -apple-system, sans-serif';
    context.fillText('Ground Floor', 92, 82);
    context.textAlign = 'right';
    context.fillStyle = '#426b8a';
    context.font = '500 27px "IBM Plex Mono", monospace';
    context.fillText('PLANNING ESTIMATE', 1700, 80);
    context.textAlign = 'left';

    context.fillStyle = '#65727c';
    context.font = '500 28px "IBM Plex Mono", monospace';
    context.fillText('START WITH THE WORK', 130, 285);
    context.fillStyle = '#111820';
    context.font = '600 100px "IBM Plex Sans", -apple-system, sans-serif';
    context.fillText('What do you need', 130, 435);
    context.fillText('help with?', 130, 545);

    const options = ['Meeting notes', 'Source-based draft', 'Document triage'];
    options.forEach((label, index) => {
      const x = 130 + index * 520;
      const selected = index === 0;
      context.fillStyle = '#ffffff';
      context.fillRect(x, 680, 450, 150);
      context.strokeStyle = selected ? '#075ea8' : '#b7c1c7';
      context.lineWidth = selected ? 5 : 3;
      context.strokeRect(x, 680, 450, 150);
      if (selected) {
        context.fillStyle = '#075ea8';
        context.fillRect(x, 818, 450, 12);
      }
      context.fillStyle = '#33404a';
      context.font = '500 31px "IBM Plex Sans", -apple-system, sans-serif';
      context.fillText(label, x + 34, 770);
    });

    context.fillStyle = '#65727c';
    context.font = '400 27px "IBM Plex Sans", -apple-system, sans-serif';
    context.fillText('Your task. Your Mac. A cautious starting point.', 130, 965);
    context.restore();

    const texture = new THREE.CanvasTexture(screenCanvas);
    texture.colorSpace = THREE.SRGBColorSpace;
    texture.anisotropy = renderer ? Math.min(8, renderer.capabilities.getMaxAnisotropy()) : 4;
    return texture;
  }

  function createAppleMarkTexture() {
    const markCanvas = document.createElement('canvas');
    markCanvas.width = 512;
    markCanvas.height = 512;
    const context = markCanvas.getContext('2d');
    if (!context) return null;
    context.clearRect(0, 0, 512, 512);
    context.fillStyle = 'rgba(78, 84, 88, 0.82)';
    context.font = '300px "Apple Symbols", -apple-system, "SF Pro Display", sans-serif';
    context.textAlign = 'center';
    context.textBaseline = 'middle';
    context.fillText('', 256, 270);
    const texture = new THREE.CanvasTexture(markCanvas);
    texture.colorSpace = THREE.SRGBColorSpace;
    return texture;
  }

  function setupScene() {
    if (!canvas || renderer) return Boolean(renderer);
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false, powerPreference: 'high-performance' });
    } catch {
      if (fallback) fallback.hidden = false;
      return false;
    }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFShadowMap;

    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x080d12);
    scene.fog = new THREE.FogExp2(0x080d12, 0.028);

    camera = new THREE.PerspectiveCamera(36, 1, 0.1, 100);
    camera.position.set(11.5, 7.4, 15);

    const hemisphere = new THREE.HemisphereLight(0xe9f4ff, 0x101317, 1.75);
    scene.add(hemisphere);
    const key = new THREE.DirectionalLight(0xffffff, 5.6);
    key.position.set(-4, 9, 8);
    key.castShadow = true;
    key.shadow.mapSize.set(2048, 2048);
    key.shadow.camera.left = -12;
    key.shadow.camera.right = 12;
    key.shadow.camera.top = 12;
    key.shadow.camera.bottom = -12;
    key.shadow.bias = -0.0004;
    scene.add(key);
    const rim = new THREE.SpotLight(0x8ec8ff, 15, 32, Math.PI / 5, 0.65, 1.6);
    rim.position.set(8, 7, -7);
    rim.target.position.set(0, 1.5, -1);
    scene.add(rim, rim.target);

    const floorMaterial = new THREE.MeshStandardMaterial({ color: 0x0c1319, roughness: 0.58, metalness: 0.12 });
    const floor = new THREE.Mesh(new THREE.PlaneGeometry(60, 60), floorMaterial);
    floor.rotation.x = -Math.PI / 2;
    floor.position.y = -0.24;
    floor.receiveShadow = true;
    scene.add(floor);

    laptop = new THREE.Group();
    scene.add(laptop);

    const aluminum = new THREE.MeshPhysicalMaterial({
      color: 0x44494d,
      metalness: 0.88,
      roughness: 0.3,
      clearcoat: 0.24,
      clearcoatRoughness: 0.3,
    });
    const aluminumDark = new THREE.MeshStandardMaterial({ color: 0x24282b, metalness: 0.86, roughness: 0.32 });
    const black = new THREE.MeshStandardMaterial({ color: 0x090c0e, metalness: 0.25, roughness: 0.38 });
    const keyMaterial = new THREE.MeshStandardMaterial({ color: 0x101315, metalness: 0.12, roughness: 0.42 });

    const baseHeight = CLOSED_HEIGHT * 0.58;
    const base = new THREE.Mesh(new RoundedBoxGeometry(CHASSIS_WIDTH, baseHeight, CHASSIS_DEPTH, 7, 0.13), aluminum);
    base.castShadow = true;
    base.receiveShadow = true;
    laptop.add(base);

    const lowerEdge = new THREE.Mesh(new RoundedBoxGeometry(CHASSIS_WIDTH * 0.996, 0.07, CHASSIS_DEPTH * 0.994, 5, 0.07), aluminumDark);
    lowerEdge.position.y = -baseHeight * 0.54;
    lowerEdge.castShadow = true;
    laptop.add(lowerEdge);

    const keyboardGeometry = new RoundedBoxGeometry(0.37, 0.045, 0.34, 2, 0.035);
    const keyCount = 14 * 5;
    const keyboard = new THREE.InstancedMesh(keyboardGeometry, keyMaterial, keyCount);
    const keyTransform = new THREE.Object3D();
    let keyIndex = 0;
    for (let row = 0; row < 5; row += 1) {
      for (let column = 0; column < 14; column += 1) {
        keyTransform.position.set(-2.9 + column * 0.445, baseHeight * 0.57, -1.92 + row * 0.43);
        keyTransform.rotation.set(0, 0, 0);
        keyTransform.updateMatrix();
        keyboard.setMatrixAt(keyIndex, keyTransform.matrix);
        keyIndex += 1;
      }
    }
    keyboard.instanceMatrix.needsUpdate = true;
    keyboard.castShadow = true;
    laptop.add(keyboard);

    const spacebar = new THREE.Mesh(new RoundedBoxGeometry(2.25, 0.045, 0.34, 2, 0.035), keyMaterial);
    spacebar.position.set(0, baseHeight * 0.57, 0.28);
    laptop.add(spacebar);
    const touchId = new THREE.Mesh(new RoundedBoxGeometry(0.38, 0.052, 0.36, 3, 0.055), keyMaterial);
    touchId.position.set(2.9, baseHeight * 0.59, -1.92);
    laptop.add(touchId);
    const touchIdRing = new THREE.Mesh(
      new THREE.TorusGeometry(0.095, 0.012, 10, 28),
      new THREE.MeshStandardMaterial({ color: 0x596066, metalness: 0.5, roughness: 0.35 })
    );
    touchIdRing.rotation.x = Math.PI / 2;
    touchIdRing.position.set(2.9, baseHeight * 0.65, -1.92);
    laptop.add(touchIdRing);
    const trackpad = new THREE.Mesh(new RoundedBoxGeometry(3.65, 0.02, 1.85, 6, 0.08), aluminumDark);
    trackpad.position.set(0, baseHeight * 0.54, 1.62);
    laptop.add(trackpad);
    const trackpadInset = new THREE.Mesh(new RoundedBoxGeometry(3.6, 0.014, 1.8, 6, 0.07), aluminum);
    trackpadInset.position.set(0, baseHeight * 0.59, 1.62);
    laptop.add(trackpadInset);

    const speakerGeometry = new THREE.CylinderGeometry(0.018, 0.018, 0.018, 10);
    const speakerMaterial = new THREE.MeshStandardMaterial({ color: 0x080a0b, metalness: 0.1, roughness: 0.5 });
    const speakerCount = 2 * 5 * 20;
    const speakers = new THREE.InstancedMesh(speakerGeometry, speakerMaterial, speakerCount);
    const speakerTransform = new THREE.Object3D();
    let speakerIndex = 0;
    [-3.48, 3.48].forEach(sideX => {
      for (let column = 0; column < 5; column += 1) {
        for (let row = 0; row < 20; row += 1) {
          speakerTransform.position.set(sideX - 0.16 + column * 0.08, baseHeight * 0.58, -1.93 + row * 0.115);
          speakerTransform.updateMatrix();
          speakers.setMatrixAt(speakerIndex, speakerTransform.matrix);
          speakerIndex += 1;
        }
      }
    });
    speakers.instanceMatrix.needsUpdate = true;
    laptop.add(speakers);

    const hingeMaterial = new THREE.MeshStandardMaterial({ color: 0x343b40, metalness: 0.88, roughness: 0.26 });
    [-2.75, 2.75].forEach(x => {
      const hinge = new THREE.Mesh(new THREE.CylinderGeometry(0.085, 0.085, 1.25, 24), hingeMaterial);
      hinge.rotation.z = Math.PI / 2;
      hinge.position.set(x, baseHeight * 0.48, -CHASSIS_DEPTH / 2 + 0.06);
      laptop?.add(hinge);
    });

    const addSidePort = (side: -1 | 1, z: number, length: number, height = 0.07) => {
      const port = new THREE.Mesh(new RoundedBoxGeometry(0.025, height, length, 3, Math.min(0.025, height / 3)), black);
      port.position.set(side * (CHASSIS_WIDTH / 2 + 0.004), -0.005, z);
      laptop?.add(port);
    };
    // Left: MagSafe 3, two Thunderbolt 5 ports, 3.5 mm headphone jack.
    addSidePort(-1, -1.94, 0.62, 0.08);
    addSidePort(-1, -1.02, 0.44, 0.07);
    addSidePort(-1, -0.38, 0.44, 0.07);
    const headphone = new THREE.Mesh(new THREE.CylinderGeometry(0.065, 0.065, 0.03, 24), black);
    headphone.rotation.z = Math.PI / 2;
    headphone.position.set(-CHASSIS_WIDTH / 2 - 0.008, -0.005, 1.73);
    laptop.add(headphone);
    // Right: HDMI, Thunderbolt 5, SDXC slot.
    addSidePort(1, -1.48, 0.7, 0.09);
    addSidePort(1, -0.48, 0.44, 0.07);
    addSidePort(1, 1.22, 0.9, 0.045);

    lidPivot = new THREE.Group();
    lidPivot.position.set(0, baseHeight * 0.48, -CHASSIS_DEPTH / 2 + 0.06);
    laptop.add(lidPivot);

    const lidWidth = CHASSIS_WIDTH * 0.986;
    const lidHeight = lidWidth / 1.505;
    const lidDepth = CLOSED_HEIGHT * 0.38;
    const shell = new THREE.Mesh(new RoundedBoxGeometry(lidWidth, lidHeight, lidDepth, 8, 0.14), aluminum);
    shell.position.set(0, lidHeight / 2, 0);
    shell.castShadow = true;
    lidPivot.add(shell);

    const appleMark = new THREE.Mesh(
      new THREE.PlaneGeometry(1.42, 1.42),
      new THREE.MeshBasicMaterial({ map: createAppleMarkTexture(), transparent: true, toneMapped: false, side: THREE.DoubleSide })
    );
    appleMark.rotation.y = Math.PI;
    appleMark.position.set(0, lidHeight / 2, -lidDepth / 2 - 0.008);
    lidPivot.add(appleMark);

    const bezelWidth = lidWidth - 0.17;
    const bezelHeight = lidHeight - 0.17;
    const bezel = new THREE.Mesh(new RoundedBoxGeometry(bezelWidth, bezelHeight, 0.07, 7, 0.115), black);
    bezel.position.set(0, lidHeight / 2, lidDepth / 2 + 0.04);
    lidPivot.add(bezel);

    const screenTexture = createScreenTexture();
    screenMaterial = new THREE.MeshBasicMaterial({ map: screenTexture, toneMapped: false, transparent: true, opacity: 0 });
    const screenWidth = lidWidth - 0.29;
    const screenHeight = screenWidth / DISPLAY_ASPECT;
    const screen = new THREE.Mesh(new THREE.PlaneGeometry(screenWidth, screenHeight), screenMaterial);
    screen.position.set(0, lidHeight / 2, lidDepth / 2 + 0.082);
    lidPivot.add(screen);

    const notch = new THREE.Mesh(new RoundedBoxGeometry(1.08, 0.27, 0.026, 6, 0.09), black);
    notch.position.set(0, lidHeight / 2 + screenHeight / 2 - 0.13, lidDepth / 2 + 0.098);
    lidPivot.add(notch);
    const cameraDot = new THREE.Mesh(new THREE.SphereGeometry(0.035, 16, 8), new THREE.MeshStandardMaterial({ color: 0x111820, roughness: 0.22 }));
    cameraDot.position.set(0.2, lidHeight / 2 + screenHeight / 2 - 0.13, lidDepth / 2 + 0.117);
    lidPivot.add(cameraDot);

    const path = new THREE.CatmullRomCurve3([
      new THREE.Vector3(11.5, 7.4, 15),
      new THREE.Vector3(8, 6, 11.7),
      new THREE.Vector3(4.3, 4.7, 8.7),
      new THREE.Vector3(1.1, 3.5, 6.5),
      new THREE.Vector3(0, 2.9, 5.8),
    ]);
    camera.userData.path = path;

    resizeRenderer();
    return true;
  }

  function resizeRenderer() {
    if (!renderer || !camera || !canvas) return;
    const width = window.innerWidth;
    const height = window.innerHeight;
    renderer.setSize(width, height, false);
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
  }

  function renderAt(time: number) {
    if (!renderer || !scene || !camera || !laptop || !lidPivot) return;

    const arrival = easeOut(range(time, 0, 1.15));
    const opening = smooth(range(time, 0.72, 2.55));
    const dolly = smooth(range(time, 2.18, 4.92));
    const screenAwake = smooth(range(time, 1.65, 2.35));

    laptop.scale.setScalar(THREE.MathUtils.lerp(0.72, 1, arrival));
    laptop.position.y = THREE.MathUtils.lerp(-0.65, -0.04, arrival);
    laptop.rotation.y = THREE.MathUtils.lerp(-1.05, 0.03, smooth(range(time, 0.05, 1.65)));
    laptop.rotation.z = THREE.MathUtils.lerp(0.12, 0, smooth(range(time, 0.15, 1.45)));
    lidPivot.rotation.x = THREE.MathUtils.lerp(1.53, 0.045, opening);

    const path = camera.userData.path as THREE.CatmullRomCurve3;
    const cameraProgress = THREE.MathUtils.lerp(0, 1, dolly);
    camera.position.copy(path.getPointAt(cameraProgress));
    const narrowViewport = clamp01((0.9 - camera.aspect) / 0.45);
    camera.position.z += narrowViewport * 2.8;
    camera.position.y += narrowViewport * 0.35;
    const target = new THREE.Vector3(
      0,
      THREE.MathUtils.lerp(0.35, 2.78, smooth(range(time, 1.7, 3.1))),
      THREE.MathUtils.lerp(-0.5, -2.68, smooth(range(time, 1.7, 3.1)))
    );
    camera.lookAt(target);
    camera.fov = THREE.MathUtils.lerp(36, 31, dolly);
    camera.updateProjectionMatrix();

    if (screenMaterial) screenMaterial.opacity = screenAwake;
    renderer.render(scene, camera);
  }

  function animate(now: number) {
    if (!playing) return;
    if (startTime === null) startTime = now;
    const time = Math.min((now - startTime) / 1000, DURATION);
    renderAt(time);

    if (time >= DURATION && !exitStarted) {
      exitStarted = true;
      entrance?.classList.add('is-exiting');
      return;
    }
    animationFrame = window.requestAnimationFrame(animate);
  }

  function finishEntrance() {
    playing = false;
    if (animationFrame) window.cancelAnimationFrame(animationFrame);
    if (!entrance) return;
    entrance.classList.remove('is-playing', 'is-exiting');
    entrance.hidden = true;
    document.documentElement.classList.remove('gf-intro-lock');
    rememberEntrance();
    document.getElementById('home-task')?.focus({ preventScroll: true });
  }

  function playEntrance(force = false) {
    if (!entrance || reduceMotion.matches || (!force && hasSeenEntrance())) {
      if (entrance) entrance.hidden = true;
      return;
    }
    if (!setupScene()) {
      finishEntrance();
      return;
    }

    entrance.hidden = false;
    entrance.classList.remove('is-exiting');
    document.documentElement.classList.add('gf-intro-lock');
    skip?.focus({ preventScroll: true });
    startTime = null;
    exitStarted = false;
    playing = true;
    renderAt(0);
    requestAnimationFrame(() => {
      entrance.classList.add('is-playing');
      animationFrame = window.requestAnimationFrame(animate);
    });
  }

  entrance?.addEventListener('animationend', event => {
    if ((event as AnimationEvent).animationName === 'gf-three-exit') finishEntrance();
  });
  skip?.addEventListener('click', finishEntrance);
  replay?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    playEntrance(true);
  });
  document.addEventListener('keydown', event => {
    if (!entrance || entrance.hidden) return;
    if (event.key === 'Escape') finishEntrance();
    if (event.key === 'Tab') {
      event.preventDefault();
      skip?.focus({ preventScroll: true });
    }
  });
  window.addEventListener('resize', resizeRenderer, { passive: true });

  const forceIntro = new URLSearchParams(window.location.search).get('intro') === '1';
  playEntrance(forceIntro);
</script>
