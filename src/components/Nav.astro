---
interface Props { appearance?: 'light' | 'dark' }
const { appearance = 'dark' } = Astro.props;
const links = [
  { href: '/setup', label: 'My Mac' },
  { href: '/learn', label: 'Deep dive' },
  { href: '/#workflows', label: 'Workflows' },
  { href: '/experiments', label: 'Evidence' },
  { href: '/playbook', label: 'How testing works' },
  { href: '/about', label: 'About' },
];
const { pathname } = Astro.url;
const active = (href: string) => href.startsWith('/#') ? false : pathname.startsWith(href);
---

<header class:list={['gf-nav', appearance === 'light' && 'gf-nav-light']}>
  <div class="gf-nav-inner">
    <a href="/" class="gf-wordmark" aria-label="Ground Floor home">Ground Floor</a>
    <nav class="gf-nav-desktop" aria-label="Primary">
      {links.map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <div class="gf-nav-actions">
      <button class="gf-theme-toggle" data-gf-theme-toggle type="button" role="switch" aria-label="Dark mode" aria-checked="true">
        <span class="gf-theme-orb" aria-hidden="true"></span>
        <span data-gf-theme-label>Dark</span>
      </button>
      <a class="gf-nav-action" href="/pilot">Tell us the task</a>
    </div>
    <button id="nav-toggle" class="gf-nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div id="mobile-menu" class="gf-mobile-menu" hidden>
    <nav aria-label="Mobile primary">
      {links.map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
      <button class="gf-theme-toggle gf-theme-toggle-mobile" data-gf-theme-toggle type="button" role="switch" aria-label="Dark mode" aria-checked="true">
        <span class="gf-theme-orb" aria-hidden="true"></span>
        <span data-gf-theme-label>Dark mode</span>
      </button>
      <a href="/pilot">Tell us the task</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const opening = menu?.hasAttribute('hidden') ?? false;
    if (opening) menu?.removeAttribute('hidden'); else menu?.setAttribute('hidden', '');
    toggle.setAttribute('aria-expanded', String(opening));
    toggle.setAttribute('aria-label', opening ? 'Close navigation' : 'Open navigation');
  });

  const themeColor = document.querySelector('meta[name="theme-color"]');
  const themeToggles = document.querySelectorAll<HTMLElement>('[data-gf-theme-toggle]');
  function syncThemeControls() {
    const dark = document.documentElement.dataset.gfTheme === 'dark';
    themeToggles.forEach(control => {
      control.setAttribute('aria-checked', String(dark));
      control.setAttribute('aria-label', 'Dark mode');
      const label = control.querySelector<HTMLElement>('[data-gf-theme-label]');
      if (label) label.textContent = 'Dark mode';
    });
    themeColor?.setAttribute('content', dark ? '#08070F' : '#F2F4F3');
  }
  themeToggles.forEach(control => control.addEventListener('click', () => {
    const next = document.documentElement.dataset.gfTheme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.gfTheme = next;
    try { localStorage.setItem('gf-theme', next); } catch { /* Theme still applies for this page. */ }
    syncThemeControls();
  }));
  syncThemeControls();
</script>
