---
import { faqPage } from '../lib/seo';

interface Props {
  items: { q: string; a: string }[];
  heading?: string;
  eyebrow?: string;
}
const { items, heading = 'Questions', eyebrow = 'FAQ' } = Astro.props;
const jsonLd = JSON.stringify(faqPage(items));
---

<!--
  Visible FAQ that doubles as FAQPage structured data.
  The schema mirrors exactly what a human reads here, no hidden or agent-only content.
  Each answer is a self-contained, entity-restated atom (answer-first) so an agent can lift it whole.
-->
<section class="max-w-prose mx-auto px-5 md:px-0 py-16 md:py-20" aria-label={heading}>
  <p class="font-mono text-[0.7rem] tracking-[0.2em] uppercase text-ash mb-3">{eyebrow}</p>
  <h2 class="font-display text-2xl font-semibold tracking-tight text-chalk mb-8">{heading}</h2>
  <dl class="divide-y" style="border-color:#2a2a2d;">
    {items.map(({ q, a }) => (
      <div class="py-5">
        <dt class="font-display text-lg text-chalk leading-snug mb-2">{q}</dt>
        <dd class="text-sm text-silver leading-relaxed">{a}</dd>
      </div>
    ))}
  </dl>
</section>

<script type="application/ld+json" set:html={jsonLd} is:inline />
