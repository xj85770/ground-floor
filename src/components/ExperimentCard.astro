---
import type { CollectionEntry } from 'astro:content';
import EvidenceBadge from './EvidenceBadge.astro';
interface Props { experiment: CollectionEntry<'experiments'>; compact?: boolean }
const { experiment } = Astro.props;
const { data, slug } = experiment;
const date = data.date.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
---
<article class="gf-task relative">
  <div>
    <strong><a class="text-inherit no-underline after:absolute after:inset-0" href={`/experiments/${slug}`}>{data.title}</a></strong>
    <p>{data.description}</p>
  </div>
  <p>{data.industry} · {data.hardware}<br />Updated {date}</p>
  <EvidenceBadge status={data.evidenceStatus} />
</article>
