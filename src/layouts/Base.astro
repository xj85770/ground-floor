---
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import { graph } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  appearance?: 'light' | 'dark';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = 'Ground Floor helps small professional practices evaluate local AI for narrow, human-reviewed documentation work.',
  ogType = 'website',
  appearance = 'dark',
  noindex = false,
  schema = [],
} = Astro.props;

const siteName = 'Ground Floor';
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://gflocal.netlify.app');
const jsonLd = graph(Astro.site, schema);
---

<!DOCTYPE html>
<html lang="en" data-gf-theme="dark" class:list={[appearance === 'light' ? 'gf-light-root' : 'gf-dark-root']}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  <meta name="author" content="Ground Floor" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="theme-color" content="#08070F" />
  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('gf-theme');
        document.documentElement.dataset.gfTheme = saved === 'light' ? 'light' : 'dark';
      } catch {
        document.documentElement.dataset.gfTheme = 'dark';
      }
    })();
  </script>
  <title>{pageTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={jsonLd} is:inline />
</head>

<body class:list={['antialiased', appearance === 'light' ? 'gf-light' : 'bg-obsidian text-chalk']}>
  <Nav appearance={appearance} />
  <main><slot /></main>

  <footer class:list={['gf-footer', appearance === 'light' && 'gf-footer-light']}>
    <div class="max-w-wide mx-auto px-5 md:px-10 py-14">
      <div class="gf-footer-grid">
        <div>
          <p class="gf-footer-name">Ground Floor</p>
          <p class="gf-footer-copy">Independent local-AI education and field testing for sensitive professional work.</p>
        </div>
        <nav aria-label="Footer">
          <a href="/setup">Check my Mac</a>
          <a href="/learn">Deep dive</a>
          <a href="/experiments">Evidence</a>
          <a href="/playbook">How testing works</a>
          <a href="/about">About</a>
          <a href="/pilot">Tell us the task</a>
          <a href="/scope">Scope &amp; Disclaimers</a>
        </nav>
      </div>
      <p class="gf-footer-legal">Ground Floor is independent technical education—not legal, compliance, medical, tax, investment, or security advice. See <a href="/scope">Scope &amp; Disclaimers</a>.</p>
    </div>
  </footer>

  <script>
    const observer = new IntersectionObserver(
      entries => entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); }),
      { threshold: 0.08 }
    );
    document.querySelectorAll('.reveal').forEach(element => observer.observe(element));
  </script>
</body>
</html>
