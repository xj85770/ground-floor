---
import Base from './Base.astro';
import ExperimentCard from '../components/ExperimentCard.astro';
import { article, faqPage, breadcrumb } from '../lib/seo';
import type { CollectionEntry } from 'astro:content';

interface Props {
  industry: CollectionEntry<'industries'>;
  experiments: CollectionEntry<'experiments'>[];
}
const { industry, experiments } = Astro.props;
const { data } = industry;
const path = `/industries/${industry.slug}`;
// FAQ mirrors the visible copy on this page (legitimate: schema reflects what a human reads).
const faq = [
  { q: `Why does local, air-gapped AI matter for ${data.name.toLowerCase()}?`, a: data.whyLocal },
  {
    q: `What can Ground Floor not tell me about ${data.shortName.toLowerCase()}?`,
    a: "The experiments here cover what's technically possible with local hardware. Your specific regulatory obligations — your state's rules, your specialty's requirements, your malpractice carrier's stance, your EHR vendor's terms — are questions this site cannot answer.",
  },
];
const schema = [
  article({ site: Astro.site, path, headline: `Local, air-gapped AI for ${data.name}`, description: data.whyLocal }),
  faqPage(faq),
  breadcrumb(Astro.site, [
    { name: 'Industries', path: '/industries' },
    { name: data.name, path },
  ]),
];
---

<Base title={data.name} description={data.whyLocal} schema={schema}>

  <div class="page-aurora">
    <div class="page-aurora-glow" style="background:radial-gradient(ellipse 70% 60% at 50% -10%,rgba(67,97,238,0.28) 0%,transparent 70%);"></div>
    <div class="max-w-prose mx-auto px-5 md:px-0 pt-20 pb-14 relative">
      <nav class="mb-8 text-xs text-ash font-mono" aria-label="Breadcrumb">
        <a href="/industries" class="hover:text-silver transition-colors">Industries</a>
        <span class="mx-2">→</span>
        <span>{data.shortName}</span>
      </nav>
      <div class="flex flex-wrap gap-1.5 mb-5">
        {data.regulation.map((reg: string) => <span class="tag">{reg}</span>)}
      </div>
      <h1 class="font-display text-3xl md:text-4xl font-semibold leading-tight tracking-tight text-chalk">
        {data.name}
      </h1>
    </div>
  </div>

  <div class="max-w-prose mx-auto px-5 md:px-0 py-16 md:py-20">

    <!-- Why local -->
    <div class="glow-card p-7 mb-10">
      <h2 class="font-mono text-[0.6rem] uppercase tracking-widest text-ash mb-4">Why local matters here</h2>
      <p class="text-base leading-editorial text-silver">{data.whyLocal}</p>
    </div>

    <!-- Use cases -->
    <section class="mb-12">
      <h2 class="font-mono text-[0.6rem] uppercase tracking-widest text-ash mb-5">Common use cases</h2>
      <ul class="space-y-2.5">
        {data.commonUseCases.map((uc: string) => (
          <li class="flex items-baseline gap-3 text-sm text-chalk">
            <span style="color:#ff6b47;" class="font-mono text-xs shrink-0">→</span>
            <span>{uc}</span>
          </li>
        ))}
      </ul>
    </section>

    {data.maturityNote && (
      <div class="glow-card p-5 mb-12 text-sm text-silver leading-relaxed">
        <span class="font-mono text-[0.6rem] uppercase tracking-widest text-ash block mb-2">Note on maturity</span>
        {data.maturityNote}
      </div>
    )}

    <div class="prose-editorial mb-14"><slot /></div>

    <!-- Experiments -->
    <section>
      <div class="section-header">
        <h2 class="font-display text-xl font-semibold text-chalk">Experiments for {data.shortName}</h2>
        {experiments.length === 0 && <span class="text-xs text-ash font-mono">Coming soon</span>}
      </div>
      {experiments.length > 0 ? (
        <div>{experiments.map(exp => <ExperimentCard experiment={exp} />)}</div>
      ) : (
        <p class="text-silver text-sm leading-relaxed py-8 border-t border-wire">
          No experiments published yet for {data.name}. The first one is in progress — check back soon, or browse{' '}
          <a href="/experiments" class="underline underline-offset-2 hover:text-chalk transition-colors">all experiments</a>.
        </p>
      )}
    </section>

    <!-- Honest gaps -->
    <section class="mt-14 pt-10 border-t border-wire">
      <h2 class="font-display text-xl font-semibold text-chalk mb-5">What this site can't answer</h2>
      <p class="text-sm text-silver leading-relaxed">
        The experiments here cover what's technically possible with local hardware.
        Your specific regulatory obligations — your state's rules, your specialty's requirements,
        your malpractice carrier's stance, your EHR vendor's terms — are questions this site cannot answer.
      </p>
      <p class="text-sm text-silver leading-relaxed mt-3">
        See the <a href="/scope" class="underline underline-offset-2 hover:text-chalk transition-colors">Scope &amp; Disclaimers</a> page.
      </p>
    </section>

    <div class="mt-10 pt-6 border-t border-wire">
      <a href="/industries" class="link-arrow"><span aria-hidden="true">←</span><span>All industries</span></a>
    </div>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('.glow-card').forEach(card => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${((e.clientX-r.left)/r.width)*100}%`);
      card.style.setProperty('--mouse-y', `${((e.clientY-r.top)/r.height)*100}%`);
    });
  });
</script>
