---
import Base from './Base.astro';
import ExperimentCard from '../components/ExperimentCard.astro';
import { page, breadcrumb } from '../lib/seo';
import type { CollectionEntry } from 'astro:content';

interface Props {
  industry: CollectionEntry<'industries'>;
  experiments: CollectionEntry<'experiments'>[];
}
const { industry, experiments } = Astro.props;
const { data } = industry;
const path = `/industries/${industry.slug}`;
const schema = [
  page('WebPage', { site: Astro.site, path, name: `Local AI task ideas for ${data.name}`, description: `Candidate documentation tasks and evidence status for ${data.name}.` }),
  breadcrumb(Astro.site, [{ name: 'Workflows', path: '/industries' }, { name: data.shortName, path }]),
];
---

<Base title={`Local AI task ideas for ${data.shortName}`} description={`Candidate documentation tasks and evidence status for ${data.name}.`} appearance="light" schema={schema}>
  <header class="gf-page-hero">
    <div class="gf-shell">
      <a class="gf-link" href="/industries">← All practice doors</a>
      <p class="gf-eyebrow mt-8">Candidate tasks · not deployment advice</p>
      <h1 class="gf-display mt-4">{data.name}</h1>
      <p class="gf-lede">The useful first question is narrow: which repetitive documentation task is worth testing under professional review?</p>
    </div>
  </header>

  <section class="gf-content">
    <div class="gf-shell grid lg:grid-cols-[1.15fr_0.85fr] gap-12 lg:gap-20 items-start">
      <div>
        <p class="gf-eyebrow">Candidate work</p>
        <h2 class="gf-h2 mt-3">Tasks a field test could examine</h2>
        <ul class="gf-copy mt-6 pl-5 list-disc space-y-3">
          {data.commonUseCases.map((useCase: string) => <li>{useCase}</li>)}
        </ul>
      </div>
      <aside class="gf-form">
        <p class="gf-eyebrow">Material boundary</p>
        <h2 class="text-xl font-semibold mt-3">Local is a data-flow choice—not a compliance verdict.</h2>
        <p class="gf-copy mt-4">A local model can avoid sending a prompt to a model API. The complete system may still involve cloud sync, backups, telemetry, transcription, plugins, or other services. Your obligations depend on the actual workflow and jurisdiction.</p>
        <a class="gf-link inline-flex mt-5" href="/scope">Read scope and disclaimers →</a>
      </aside>
    </div>
  </section>

  <section class="gf-section gf-section-soft">
    <div class="gf-shell">
      <div class="gf-section-head"><p class="gf-eyebrow">Evidence</p><h2 class="gf-h2 mt-3">What has actually been tested?</h2><p class="gf-copy">A protocol describes a future test. It is not a result.</p></div>
      {experiments.length ? <div class="gf-task-list">{experiments.map(experiment => <ExperimentCard experiment={experiment} />)}</div> : <div class="gf-form"><p class="gf-copy">No protocol is published for this practice yet.</p></div>}
    </div>
  </section>

  <section class="gf-section gf-section-white">
    <div class="gf-shell"><div class="gf-cta"><div><p class="gf-eyebrow">A real task is more useful than a broad category</p><h2>Tell us what currently eats your time.</h2></div><a class="gf-button" href="/pilot">Tell us the task</a></div></div>
  </section>
</Base>
