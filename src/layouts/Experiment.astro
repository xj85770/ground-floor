---
import Base from './Base.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import { article, breadcrumb } from '../lib/seo';
import type { CollectionEntry } from 'astro:content';
interface Props { experiment: CollectionEntry<'experiments'> }
const { experiment } = Astro.props;
const { data } = experiment;
const date = data.date.toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' });
const path = `/experiments/${experiment.slug}`;
const schema = [
  article({ site:Astro.site, path, headline:data.title, description:data.description, datePublished:data.date, techArticle:true, about:[data.industry,data.task,'Validation protocol'] }),
  breadcrumb(Astro.site, [{ name:'Ground Floor', path:'/' }, { name:'Evidence', path:'/experiments' }, { name:data.title, path }]),
];
---
<Base title={data.title} description={data.description} ogType="article" appearance="light" schema={schema}>
  <header class="gf-page-hero">
    <div class="gf-shell max-w-[900px]">
      <nav class="text-[13px] text-[#63707a] mb-8" aria-label="Breadcrumb"><a href="/experiments">Evidence</a> <span class="mx-2">/</span> Protocol {String(data.week).padStart(2,'0')}</nav>
      <EvidenceBadge status={data.evidenceStatus} />
      <h1 class="gf-display mt-5 !max-w-[18ch]">{data.title}</h1>
      <p class="gf-lede mt-5">{data.description}</p>
      <p class="gf-eyebrow mt-6">Updated {date} · {data.industry} · {data.hardware}</p>
    </div>
  </header>
  <div class="gf-content">
    <div class="gf-shell grid lg:grid-cols-[1fr_260px] gap-12 lg:gap-20 items-start">
      <article class="gf-prose"><slot /></article>
      <aside class="border-t-4 border-[#111820] pt-5 lg:sticky lg:top-24">
        <p class="gf-eyebrow">Planned configuration</p>
        <dl class="text-[13px] leading-relaxed mt-4">
          <dt class="text-[#63707a]">Model target</dt><dd class="mt-1 mb-4">{data.model}</dd>
          <dt class="text-[#63707a]">Hardware target</dt><dd class="mt-1 mb-4">{data.hardware}</dd>
          <dt class="text-[#63707a]">Task</dt><dd class="mt-1 mb-4">{data.task}</dd>
        </dl>
        <a class="gf-link text-[13px]" href="/experiments">Back to evidence</a>
      </aside>
    </div>
  </div>
</Base>
