---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { page, breadcrumb } from '../../lib/seo';

const industries = (await getCollection('industries')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const experiments = await getCollection('experiments');
const counts = experiments.reduce<Record<string, number>>((all, item) => {
  all[item.data.industry] = (all[item.data.industry] ?? 0) + 1;
  return all;
}, {});
const schema = [
  page('CollectionPage', { site: Astro.site, path: '/industries', name: 'Local AI workflow starting points by practice', description: 'Candidate documentation tasks and evidence status for small professional practices evaluating local AI.' }),
  breadcrumb(Astro.site, [{ name: 'Workflows', path: '/industries' }]),
];
---

<Base title="Workflow starting points by practice" description="Candidate documentation tasks and evidence status for small professional practices evaluating local AI." appearance="light" schema={schema}>
  <header class="gf-page-hero">
    <div class="gf-shell">
      <p class="gf-eyebrow">Practice doors</p>
      <h1 class="gf-display mt-4">Start with the task, not the technology.</h1>
      <p class="gf-lede">Choose the work you want help with. These pages organize candidate tasks; they do not establish that a workflow is safe, compliant, or useful in your practice.</p>
    </div>
  </header>

  <section class="gf-content">
    <div class="gf-shell">
      <div class="gf-task-list">
        {industries.map((industry) => (
          <a class="gf-task" href={`/industries/${industry.slug}`}>
            <div>
              <p class="gf-eyebrow">{industry.data.shortName}</p>
              <h2>{industry.data.name}</h2>
              <p>{industry.data.commonUseCases.slice(0, 3).join(' · ')}</p>
            </div>
            <div class="gf-task-meta">
              <span class="gf-status">{counts[industry.slug] ?? 0} protocol{(counts[industry.slug] ?? 0) === 1 ? '' : 's'}</span>
              <span aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
      <div class="gf-boundary-grid mt-12">
        <div><h3>What these pages do</h3><ul><li>Translate broad interest into narrow documentation tasks.</li><li>Show whether Ground Floor has a protocol for the task.</li><li>State the human review requirement.</li></ul></div>
        <div><h3>What they do not do</h3><ul><li>Give legal, medical, tax, security, or compliance advice.</li><li>Certify a deployment for a profession or jurisdiction.</li><li>Turn a planned protocol into measured evidence.</li></ul></div>
      </div>
    </div>
  </section>
</Base>
