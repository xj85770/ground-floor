---
import Base from '../../layouts/Base.astro';
import IndustryCard from '../../components/IndustryCard.astro';
import Faq from '../../components/Faq.astro';
import { getCollection } from 'astro:content';
import { page, breadcrumb } from '../../lib/seo';

const faq = [
  { q: 'Which regulated industries does Ground Floor cover?', a: 'Ground Floor documents local, air-gapped AI for regulated practices: medical, legal, financial, and accounting. Each industry page explains why the data usually cannot go to a cloud API, the common tasks people want help with, and which of those a local model can handle today.' },
  { q: 'Why does local AI matter more for regulated work?', a: 'In regulated work the data itself is the constraint. Patient records, privileged files, and financial accounts often cannot leave the building by rule. A local open-weight model keeps the data on hardware you own, so there is no API call and no third party holding a copy. That removes the exposure a cloud tool creates.' },
  { q: 'Does running AI locally make my practice compliant?', a: 'No, and Ground Floor is careful about this. Running a model locally removes one large exposure, the data leaving your control, but it does not by itself make you HIPAA-compliant or satisfy your specific obligations. Those depend on your rules, your specialty, and your carrier. The Scope page spells out what this site can and cannot answer.' },
];

const industries  = await getCollection('industries');
const experiments = await getCollection('experiments');

const expCount = experiments.reduce<Record<string, number>>((acc, e) => {
  acc[e.data.industry] = (acc[e.data.industry] ?? 0) + 1;
  return acc;
}, {});

const sorted = industries.sort((a, b) => a.data.name.localeCompare(b.data.name));
const schema = [
  page('CollectionPage', { site: Astro.site, path: '/industries', name: 'Regulated industries served by Ground Floor', description: 'Local LLM experiments for regulated practices — medical, legal, financial. Your data never leaves your building.' }),
  breadcrumb(Astro.site, [{ name: 'Industries', path: '/industries' }]),
];
---

<Base
  title="Industries"
  description="Local LLM experiments for regulated practices — medical, legal, financial. Your data never leaves your building."
  schema={schema}
>
  <!-- Page hero -->
  <div class="page-aurora">
    <div class="page-aurora-glow" style="background:radial-gradient(ellipse 70% 60% at 50% -10%,rgba(67,97,238,0.3) 0%,transparent 70%);"></div>
    <div class="max-w-wide mx-auto px-5 md:px-10 pt-24 pb-20 relative">
      <p class="font-mono text-[0.7rem] tracking-[0.2em] uppercase mb-4" style="color:#4361ee;">
        Regulated verticals
      </p>
      <h1 class="font-display font-semibold tracking-tight text-chalk mb-4"
          style="font-size:clamp(2.4rem,5vw,3.75rem);line-height:1.06;">
        Which practice can't send<br />data to the cloud?
      </h1>
      <p class="text-silver text-lg max-w-xl leading-relaxed">
        Every experiment is designed for practitioners who can't send client data to a cloud API —
        and who have reasonable grounds for that reluctance. The question each one answers is the same:
        does it work, and at what hardware tier?
      </p>
    </div>
  </div>

  <div class="max-w-wide mx-auto px-5 md:px-10 py-16 md:py-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {sorted.map(ind => (
        <IndustryCard industry={ind} experimentCount={expCount[ind.slug] ?? 0} />
      ))}
    </div>

    <p class="mt-10 text-sm text-ash leading-relaxed max-w-prose">
      Don't see your industry? The setup applies to any practice that can't send client data to a third party.{' '}
      <a href="/about" class="underline underline-offset-2 hover:text-chalk transition-colors">Reach out</a>{' '}
      — I'll consider it for a future experiment.
    </p>
  </div>

  <Faq items={faq} heading="Local AI for regulated industries: common questions" eyebrow="FAQ" />
</Base>
