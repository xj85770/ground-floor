---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { dataset, breadcrumb } from '../lib/seo';

const allHardware = await getCollection('hardware');
const tierOrder: Record<string, number> = { entry:0, mid:1, high:2, workstation:3 };
const sorted = allHardware.sort((a,b) => tierOrder[a.data.tier] - tierOrder[b.data.tier]);
const schema = [
  dataset({ site: Astro.site, path: '/hardware', name: 'Apple Silicon Macs for local LLM inference', description: 'Every Apple Silicon Mac configuration for local LLM inference — specs, prices, and which open-source models run on each.' }),
  breadcrumb(Astro.site, [{ name: 'Hardware', path: '/hardware' }]),
];
---

