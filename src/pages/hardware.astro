---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allHardware = await getCollection('hardware');
const tierOrder: Record<string, number> = { entry:0, mid:1, high:2, workstation:3 };
const sorted = allHardware.sort((a,b) => tierOrder[a.data.tier] - tierOrder[b.data.tier]);
---

<Base
  title="Hardware"
  description="Every Apple Silicon Mac configuration for local LLM inference — specs, prices, and which open-source models run on each."
>
  <div class="page-aurora">
    <div class="page-aurora-glow" style="background:radial-gradient(ellipse 70% 60% at 50% -10%,rgba(76,201,240,0.2) 0%,transparent 70%);"></div>
    <div class="max-w-wide mx-auto px-5 md:px-10 pt-24 pb-20 relative">
      <p class="font-mono text-[0.7rem] tracking-[0.2em] uppercase mb-4" style="color:#4cc9f0;">The hardware</p>
      <h1 class="font-display font-semibold tracking-tight text-chalk mb-4"
          style="font-size:clamp(2.4rem,5vw,3.75rem);line-height:1.06;">
        Pick your tier.<br />Run it locally.
      </h1>
      <p class="text-silver text-lg max-w-xl leading-relaxed">
        Every config below ships with zero cloud dependency. Select a RAM and storage option
        to see exact pricing and which open-source models it runs.
      </p>
    </div>
  </div>

  <div class="max-w-wide mx-auto px-5 md:px-10 py-16 md:py-24">

    <!-- Lab banner -->
    <div class="conic-border mb-16">
      <div class="p-7 md:p-9">
        <p class="font-mono text-[0.65rem] tracking-[0.18em] uppercase mb-3" style="color:#9b5de5;">Ground Floor Lab · what these experiments run on</p>
        <h2 class="font-display font-semibold text-xl text-chalk mb-1">MacBook Pro M5 Max · 128 GB · 2 TB · × 2 nodes</h2>
        <p class="text-silver text-sm max-w-lg leading-relaxed mb-3">Connected over TB5 RDMA at ~3 µs. When an experiment is documented as "viable at entry level," the config was deliberately throttled to match that tier.</p>
        <p class="font-mono text-[0.65rem] text-ash mb-6">Machine: $5,199 each · AppleCare+: $399 each · TB5 cables included — all open-source, fully air-gapped</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
          {[['256 GB','Combined memory'],['4 TB','Combined storage'],['~800 GB/s','Peak bandwidth'],['~3 µs','TB5 RDMA latency']].map(([v,l]) => (
            <div>
              <p class="font-display font-semibold text-2xl gradient-text-animated mb-0.5">{v}</p>
              <p class="font-mono text-[0.6rem] uppercase tracking-widest text-ash">{l}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ── Config cards ── -->
    <!-- Each card has a <select> dropdown; JS updates price + model list -->

    <!-- MAC MINI M4 -->
    <div class="config-card glow-card p-7 md:p-8 mb-6" data-card="mac-mini-m4">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div>
          <p class="font-mono text-[0.65rem] tracking-widest uppercase text-ash mb-1">Entry · Mac mini</p>
          <h2 class="font-display font-semibold text-2xl text-chalk">Mac mini <span style="color:#9b5de5;">M4</span></h2>
        </div>
        <div class="text-right">
          <p class="font-mono text-[0.6rem] uppercase tracking-widest text-ash mb-1">From</p>
          <p class="config-price font-display font-semibold text-2xl text-chalk">$799</p>
        </div>
      </div>

      <label class="block font-mono text-[0.6rem] uppercase tracking-widest text-ash mb-2">Configuration</label>
      <select class="config-select w-full md:w-auto bg-fog border border-wire text-chalk text-sm rounded-lg px-4 py-2.5 mb-6 cursor-pointer focus:outline-none focus:border-glow-purple"
        data-configs='[
          {"label":"16 GB · 512 GB SSD","price":799,"models":["Qwen3.5 9B Q4_K_M — strongest 9B on current benchmarks","Phi-4-mini 3.8B Q8 — fastest, structured tasks","Gemma 4 4B Q8 — Google, excellent instruction-following","DeepSeek-R1 7B Q4_K_M — chain-of-thought reasoning","Qwen3.5 4B Q8 — very fast, solid for simple drafts","Llama 3.2 3B Q8 — lightweight, simple drafts"],"note":"Runs one model at a time. Hot-swap in ~10 s via Ollama."},
          {"label":"16 GB · 1 TB SSD","price":999,"models":["Qwen3.5 9B Q4_K_M — strongest 9B on current benchmarks","Phi-4-mini 3.8B Q8 — fastest, structured tasks","Gemma 4 4B Q8 — Google, excellent instruction-following","DeepSeek-R1 7B Q4_K_M — chain-of-thought reasoning","Qwen3.5 4B Q8 — very fast, solid for simple drafts","Llama 3.2 3B Q8 — lightweight, simple drafts"],"note":"Same RAM as base — extra storage for more models on disk."},
          {"label":"24 GB · 512 GB SSD","price":1099,"models":["Qwen3.5 27B Q4_K_M — big step up, current gen Alibaba","DeepSeek-R1 14B Q4_K_M — shows chain-of-thought","Phi-4 14B Q4_K_M — Microsoft, best for structured docs","Gemma 4 31B Q4_K_M — Google, runs tight in 24 GB","Qwen3.5 9B Q8 — full-precision 9B, noticeably sharper","Mistral Small 3 22B Q4_K_M — reliable mid-size"],"note":"First tier where 14–27B models run at practical speed."},
          {"label":"24 GB · 1 TB SSD","price":1299,"models":["Qwen3.5 27B Q4_K_M — big step up, current gen Alibaba","DeepSeek-R1 14B Q4_K_M — shows chain-of-thought","Phi-4 14B Q4_K_M — Microsoft, best for structured docs","Gemma 4 31B Q4_K_M — Google, runs tight in 24 GB","Qwen3.5 9B Q8 — full-precision 9B, noticeably sharper","Mistral Small 3 22B Q4_K_M — reliable mid-size"],"note":"More disk space for storing multiple models."}
        ]'>
        <option>16 GB · 512 GB SSD — $799</option>
        <option>16 GB · 1 TB SSD — $999</option>
        <option>24 GB · 512 GB SSD — $1,099</option>
        <option>24 GB · 1 TB SSD — $1,299</option>
      </select>

      <div class="config-models grid grid-cols-1 md:grid-cols-2 gap-2 mb-4">
        <!-- filled by JS -->
      </div>
      <p class="config-note font-mono text-[0.65rem] text-ash leading-relaxed"></p>
    </div>

    <!-- MAC MINI M4 PRO -->
    <div class="config-card glow-card p-7 md:p-8 mb-6" data-card="mac-mini-m4-pro">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div>
          <p class="font-mono text-[0.65rem] tracking-widest uppercase text-ash mb-1">Mid-range · Mac mini</p>
          <h2 class="font-display font-semibold text-2xl text-chalk">Mac mini <span style="color:#4361ee;">M4 Pro</span></h2>
        </div>
        <div class="text-right">
          <p class="font-mono text-[0.6rem] uppercase tracking-widest text-ash mb-1">From</p>
          <p class="config-price font-display font-semibold text-2xl text-chalk">$1,399</p>
        </div>
      </div>

      <label class="block font-mono text-[0.6rem] uppercase tracking-widest text-ash mb-2">Configuration</label>
      <select class="config-select w-full md:w-auto bg-fog border border-wire text-chalk text-sm rounded-lg px-4 py-2.5 mb-6 cursor-pointer focus:outline-none focus:border-glow-purple"
        data-configs='[
          {"label":"24 GB · 512 GB SSD","price":1399,"models":["Qwen3.5 27B Q4_K_M — current-gen Alibaba, best at tier","DeepSeek-R1 14B Q4_K_M — auditable chain-of-thought","Phi-4 14B Q4_K_M — Microsoft, structured docs","Gemma 4 31B Q4_K_M — Google, excellent instruction-following","Qwen3.5 9B Q8 — full-precision 9B","Mistral Small 3 22B Q4_K_M — reliable mid-size"],"note":"Hot-load one 14–27B model. Swap to a second in ~15 s."},
          {"label":"24 GB · 1 TB SSD","price":1599,"models":["Qwen3.5 27B Q4_K_M — current-gen Alibaba, best at tier","DeepSeek-R1 14B Q4_K_M — auditable chain-of-thought","Phi-4 14B Q4_K_M — Microsoft, structured docs","Gemma 4 31B Q4_K_M — Google, excellent instruction-following","Qwen3.5 9B Q8 — full-precision 9B","Mistral Small 3 22B Q4_K_M — reliable mid-size"],"note":"More storage — keep 8–10 models on disk, swap freely."},
          {"label":"48 GB · 512 GB SSD","price":1799,"models":["Qwen3.5 27B Q8 — full-precision, near-frontier quality","DeepSeek-R1 32B Q4_K_M — deep reasoning with CoT","Gemma 4 31B Q4_K_M — Google, fast and capable","Phi-4 14B Q8 — full-precision, best quality at size","Mistral Small 3 22B Q8 — full-precision mid-size","Two 14B models simultaneously (hot-loaded)"],"note":"First tier for 32B models at Q4. Runs two 14B models simultaneously."},
          {"label":"48 GB · 1 TB SSD","price":1999,"models":["Qwen3.5 27B Q8 — full-precision, near-frontier quality","DeepSeek-R1 32B Q4_K_M — deep reasoning with CoT","Gemma 4 31B Q4_K_M — Google, fast and capable","Phi-4 14B Q8 — full-precision, best quality at size","Mistral Small 3 22B Q8 — full-precision mid-size","Two 14B models simultaneously (hot-loaded)"],"note":"Recommended config for small-team serving (2–4 users)."}
        ]'>
        <option>24 GB · 512 GB SSD — $1,399</option>
        <option>24 GB · 1 TB SSD — $1,599</option>
        <option>48 GB · 512 GB SSD — $1,799</option>
        <option>48 GB · 1 TB SSD — $1,999</option>
      </select>

      <div class="config-models grid grid-cols-1 md:grid-cols-2 gap-2 mb-4"></div>
      <p class="config-note font-mono text-[0.65rem] text-ash leading-relaxed"></p>
    </div>

    <!-- MACBOOK PRO M4 MAX -->
    <div class="config-card glow-card p-7 md:p-8 mb-6" data-card="mbp-m4-max">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div>
          <p class="font-mono text-[0.65rem] tracking-widest uppercase text-ash mb-1">High-end · MacBook Pro</p>
          <h2 class="font-display font-semibold text-2xl text-chalk">MacBook Pro <span style="color:#4cc9f0;">M4 Max</span></h2>
        </div>
        <div class="text-right">
          <p class="font-mono text-[0.6rem] uppercase tracking-widest text-ash mb-1">From</p>
          <p class="config-price font-display font-semibold text-2xl text-chalk">$2,499</p>
        </div>
      </div>

      <label class="block font-mono text-[0.6rem] uppercase tracking-widest text-ash mb-2">Configuration</label>
      <select class="config-select w-full md:w-auto bg-fog border border-wire text-chalk text-sm rounded-lg px-4 py-2.5 mb-6 cursor-pointer focus:outline-none focus:border-glow-purple"
        data-configs='[
          {"label":"36 GB · 1 TB SSD","price":2499,"models":["Qwen3.5 27B Q8 — full-precision current-gen Alibaba","Gemma 4 31B Q4_K_M — Google, near-frontier quality","DeepSeek-R1 32B Q4_K_M — deep reasoning with CoT","Mistral Small 3 22B Q8 — full-precision 22B","Kimi K2.6 32B Q4_K_M — #1 open benchmark, coding"],"note":"Runs 27–32B class models. Strong step up from Mac mini tier."},
          {"label":"36 GB · 2 TB SSD","price":2699,"models":["Qwen3.5 27B Q8 — full-precision current-gen Alibaba","Gemma 4 31B Q4_K_M — Google, near-frontier quality","DeepSeek-R1 32B Q4_K_M — deep reasoning with CoT","Mistral Small 3 22B Q8 — full-precision 22B","Kimi K2.6 32B Q4_K_M — #1 open benchmark, coding"],"note":"Recommended for primary work machine — extra storage pays off."},
          {"label":"64 GB · 1 TB SSD","price":3299,"models":["Kimi K2.6 Q4_K_M — #1 open-weight benchmark (score 54/100)","Llama 3.3 70B Q4_K_M — Meta flagship, ~12 t/s","DeepSeek-R1 70B Q4_K_M — reasoning with full CoT","Gemma 4 31B Q8 — full-precision Google MoE","Qwen3.5 27B Q8 — full-precision current-gen"],"note":"First tier for 70B-class models at practical speed. Recommended for complex legal/clinical work."},
          {"label":"64 GB · 2 TB SSD","price":3499,"models":["Kimi K2.6 Q4_K_M — #1 open-weight benchmark (score 54/100)","Llama 3.3 70B Q4_K_M — Meta flagship, ~12 t/s","DeepSeek-R1 70B Q4_K_M — reasoning with full CoT","Gemma 4 31B Q8 — full-precision Google MoE","Qwen3.5 27B Q8 — full-precision current-gen"],"note":"Best M4 Max config. 70B inference with full room for OS and tools."}
        ]'>
        <option>36 GB · 1 TB SSD — $2,499</option>
        <option>36 GB · 2 TB SSD — $2,699</option>
        <option>64 GB · 1 TB SSD — $3,299</option>
        <option>64 GB · 2 TB SSD — $3,499</option>
      </select>

      <div class="config-models grid grid-cols-1 md:grid-cols-2 gap-2 mb-4"></div>
      <p class="config-note font-mono text-[0.65rem] text-ash leading-relaxed"></p>
    </div>

    <!-- MACBOOK PRO M5 MAX — Lab config -->
    <div class="config-card conic-border p-7 md:p-8 mb-16" data-card="mbp-m5-max">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-2">
        <div>
          <p class="font-mono text-[0.65rem] tracking-widest uppercase mb-1" style="color:#9b5de5;">Workstation · MacBook Pro · Ground Floor Lab</p>
          <h2 class="font-display font-semibold text-2xl text-chalk">MacBook Pro <span class="gradient-text-animated">M5 Max</span></h2>
        </div>
        <div class="text-right">
          <p class="font-mono text-[0.6rem] uppercase tracking-widest text-ash mb-1">From</p>
          <p class="config-price font-display font-semibold text-2xl text-chalk">$3,899</p>
        </div>
      </div>
      <p class="text-ash text-xs font-mono mb-6">16-inch · 18-core CPU · All prices are Apple US list price before tax.</p>

      <label class="block font-mono text-[0.6rem] uppercase tracking-widest text-ash mb-2">Configuration</label>
      <select class="config-select w-full md:w-auto bg-fog border border-wire text-chalk text-sm rounded-lg px-4 py-2.5 mb-6 cursor-pointer focus:outline-none focus:border-glow-purple"
        data-configs='[
          {"label":"36 GB · 2 TB · 32-core GPU","price":3899,"models":["Kimi K2.6 32B Q4_K_M — #1 open-weight benchmark","Gemma 4 31B Q4_K_M — Google MoE, blazing fast","DeepSeek-R1 32B Q4_K_M — reasoning with chain-of-thought","Qwen3.5 27B Q8 — full-precision current-gen","Mistral Small 3 22B Q8 — reliable full-precision mid-size"],"note":"Base M5 Max. Strong 32B inference. Fast for team serving."},
          {"label":"48 GB · 2 TB · 40-core GPU","price":4399,"models":["Kimi K2.6 32B Q8 — full-precision #1 open-weight","Gemma 4 31B Q8 — full-precision Google MoE","DeepSeek-R1 32B Q8 — full-precision reasoning","Llama 3.3 70B Q4_K_M — 70B at practical speed (~14 t/s)","Two 27B models simultaneously (hot-loaded)"],"note":"40-core GPU baseline. First M5 Max tier for 70B at practical speed."},
          {"label":"64 GB · 2 TB · 40-core GPU","price":4599,"models":["Kimi K2.6 Q4_K_M — #1 open-weight benchmark (~16 t/s)","Llama 3.3 70B Q4_K_M — ~16 t/s","DeepSeek-R1 70B Q4_K_M — best open reasoning","Gemma 4 31B Q8 — full-precision, very fast","Qwen3.5 27B Q8 — full-precision current-gen"],"note":"Headroom for 70B + OS + tools simultaneously. Good team server."},
          {"label":"128 GB · 2 TB · 40-core GPU","price":5199,"models":["Kimi K2.6 Q4_K_M — #1 open-weight (score 54/100)","Kimi K2.6 Q8 — full-precision, highest quality (~18 t/s)","Llama 3.3 70B Q8 — full-precision Meta flagship","DeepSeek-R1 70B Q8 — full-precision reasoning","Qwen3.5 122B A10B Q4_K_M — 122B MoE, fits in ~61 GB","Two 70B models simultaneously (hot-loaded)"],"note":"Lab config (standard display). Three 70B models hot-loaded simultaneously."},
          {"label":"128 GB · 2 TB · nano-texture","price":5349,"models":["Kimi K2.6 Q4_K_M — #1 open-weight (score 54/100)","Kimi K2.6 Q8 — full-precision, highest quality","Llama 3.3 70B Q8 — full-precision Meta flagship","DeepSeek-R1 70B Q8 — full-precision reasoning","Qwen3.5 122B A10B Q4_K_M — 122B MoE, fits in ~61 GB","Two 70B models simultaneously (hot-loaded)"],"note":"Lab config + nano-texture display. Same inference performance."},
          {"label":"128 GB · 4 TB · 40-core GPU","price":5799,"models":["Kimi K2.6 Q8 — full-precision #1 open-weight","Llama 3.3 70B Q8 — full-precision 70B","DeepSeek-R1 70B Q8 — full-precision reasoning","Qwen3.5 122B A10B Q4_K_M — 122B MoE","Gemma 4 31B Q8 + Qwen3.5 27B Q8 (simultaneously)","Three 70B models hot-loaded simultaneously"],"note":"Extra storage for full model library. Same inference speed as 2 TB."},
          {"label":"128 GB · 4 TB · nano-texture","price":5949,"models":["Kimi K2.6 Q8 — full-precision #1 open-weight","Llama 3.3 70B Q8 — full-precision 70B","DeepSeek-R1 70B Q8 — full-precision reasoning","Qwen3.5 122B A10B Q4_K_M — 122B MoE","Gemma 4 31B Q8 + Qwen3.5 27B Q8 (simultaneously)","Three 70B models hot-loaded simultaneously"],"note":"Most popular high-end config. Nano display + full model library storage."},
          {"label":"128 GB · 8 TB · standard display","price":7199,"models":["Entire open-weight model library fits on disk","Kimi K2.6 Q8 + Llama 3.3 70B Q8 (simultaneously)","DeepSeek-R1 70B Q8","Qwen3.5 122B A10B Q4_K_M — 122B MoE","MiMo-V2.5-Pro Q4_K_M — Xiaomi, ties #1 benchmark","FP16 models possible via TB5 cluster"],"note":"Maximum storage. Keep every major open-weight model on disk."},
          {"label":"128 GB · 8 TB · nano-texture","price":7349,"models":["Entire open-weight model library fits on disk","Kimi K2.6 Q8 + Llama 3.3 70B Q8 (simultaneously)","DeepSeek-R1 70B Q8","Qwen3.5 122B A10B Q4_K_M — 122B MoE","MiMo-V2.5-Pro Q4_K_M — Xiaomi, ties #1 benchmark","FP16 models possible via TB5 cluster"],"note":"Maxed out. $7,349 list price before tax. Nano display + full model library."}
        ]'>
        <option>36 GB · 2 TB · 32-core GPU — $3,899</option>
        <option>48 GB · 2 TB · 40-core GPU — $4,399</option>
        <option>64 GB · 2 TB · 40-core GPU — $4,599</option>
        <option>128 GB · 2 TB · standard display — $5,199 ★ Lab config</option>
        <option>128 GB · 2 TB · nano-texture — $5,349</option>
        <option>128 GB · 4 TB · standard display — $5,799</option>
        <option>128 GB · 4 TB · nano-texture — $5,949</option>
        <option>128 GB · 8 TB · standard display — $7,199</option>
        <option>128 GB · 8 TB · nano-texture — $7,349</option>
      </select>

      <div class="config-models grid grid-cols-1 md:grid-cols-2 gap-2 mb-4"></div>
      <p class="config-note font-mono text-[0.65rem] text-ash leading-relaxed"></p>
    </div>

    <!-- Why Apple Silicon -->
    <section class="max-w-prose mb-16 border-t border-wire pt-12">
      <h2 class="font-display text-2xl font-semibold tracking-tight text-chalk mb-6">Why Apple Silicon</h2>
      <div class="space-y-4 text-[1.0625rem] leading-editorial text-silver">
        <p>Traditional GPU inference requires fitting the entire model in VRAM. A 16 GB consumer GPU cannot run a Q4-quantized 13B model — it doesn't fit. Your options were an expensive workstation GPU or a cloud API.</p>
        <p>Apple Silicon's unified memory means GPU and CPU share one pool. A 16 GB Mac mini loads a Q4 8B model (~5 GB) with room for the OS and other apps. No VRAM ceiling.</p>
        <p>Every model listed here is open-weight: publicly released weights, no API keys, no telemetry, no vendor agreement. The weights you download today run the same way in five years — fully air-gapped if needed.</p>
      </div>
    </section>

    <!-- Cost reality -->
    <section class="max-w-prose border-t border-wire pt-12 mb-16">
      <h2 class="font-display text-2xl font-semibold tracking-tight text-chalk mb-6">The real cost question</h2>
      <div class="space-y-4 text-[1.0625rem] leading-editorial text-silver">
        <p>The financial argument for local isn't API cost savings. At $0.01 per document interaction with cloud models, token savings don't recoup hardware for years.</p>
        <p>The real cost is compliance overhead: the vendor due diligence, the BAA negotiations, the conversation with your malpractice carrier about your AI vendor's breach notification process. A local machine eliminates most of that — not by being cheaper per token, but by removing the third-party processor from the compliance equation entirely.</p>
        <p>The hardware also has a 4–6 year useful life and does everything else a laptop or desktop does. It's infrastructure, not a pure AI line item.</p>
      </div>
    </section>

    <!-- Scaling roadmap -->
    <section class="border-t border-wire pt-12">
      <p class="font-mono text-[0.65rem] tracking-[0.18em] uppercase mb-3" style="color:#4cc9f0;">Lab roadmap</p>
      <h2 class="font-display text-2xl font-semibold tracking-tight text-chalk mb-2">Scaling to 2 TB unified memory</h2>
      <p class="text-silver text-sm max-w-xl leading-relaxed mb-10">
        The current two-node TB5 cluster is a step on a longer path. The goal is 2 TB of unified memory —
        two 1 TB cluster nodes — unlocking full-precision inference on the largest open-weight models that exist
        and will exist. No cloud. No API. No ceiling imposed by a vendor.
      </p>

      <!-- Timeline steps -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">

        <!-- Step 1: Now -->
        <div class="glow-card p-6">
          <div class="flex items-center justify-between mb-1">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center text-[0.6rem] font-mono font-bold flex-shrink-0"
                    style="background:rgba(155,93,229,0.2);border:1px solid rgba(155,93,229,0.4);color:#9b5de5;">1</span>
              <span class="font-mono text-[0.6rem] tracking-widest uppercase" style="color:#9b5de5;">Current · Active</span>
            </div>
            <span class="font-mono text-[0.6rem] tracking-widest uppercase" style="color:#9b5de5;">Known cost</span>
          </div>
          <div class="flex items-baseline justify-between mb-4">
            <div>
              <p class="font-display font-semibold text-chalk text-lg mb-0.5">256 GB cluster</p>
              <p class="font-mono text-[0.65rem] text-ash">2× M5 Max 128 GB · TB5 RDMA</p>
            </div>
            <p class="font-display font-semibold text-xl" style="color:#9b5de5;">~$11,300</p>
          </div>
          <div class="space-y-1.5 mb-4">
            {[
              ['2× MBP M5 Max 128 GB', '$10,398'],
              ['2× AppleCare+', '$798'],
              ['TB5 cables', '~$100'],
            ].map(([label, price]) => (
              <div class="flex items-center justify-between text-xs">
                <span class="text-ash">{label}</span>
                <span class="font-mono text-silver">{price}</span>
              </div>
            ))}
          </div>
          <div class="border-t pt-3 space-y-1.5" style="border-color:#2a2a2d;">
            {[
              '244 GB usable (12 GB Metal overhead)',
              'DeepSeek-R1 671B at Q2_K',
              'Qwen3.5 235B A22B at Q8',
            ].map(item => (
              <div class="flex items-start gap-2 text-xs text-silver">
                <span style="color:#9b5de5;flex-shrink:0;">·</span>
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Step 2: Next -->
        <div class="p-6 rounded-2xl" style="border:1px solid #2a2a2d;background:rgba(255,255,255,0.02);">
          <div class="flex items-center justify-between mb-1">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center text-[0.6rem] font-mono font-bold flex-shrink-0"
                    style="background:rgba(76,201,240,0.1);border:1px solid rgba(76,201,240,0.2);color:#4cc9f0;">2</span>
