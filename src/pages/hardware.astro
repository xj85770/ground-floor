<script>
  function formatPrice(n: number) {
    return '$' + n.toLocaleString('en-US');
  }

  function renderModels(card: HTMLElement, models: string[], note: string, price: number) {
    const priceEl  = card.querySelector<HTMLElement>('.config-price');
    const modelsEl = card.querySelector<HTMLElement>('.config-models');
    const noteEl   = card.querySelector<HTMLElement>('.config-note');
    if (priceEl)  priceEl.textContent  = formatPrice(price);
    if (noteEl)   noteEl.textContent   = note;
    if (modelsEl) {
      modelsEl.innerHTML = models.map(m =>
        `<div class="config-model-item">
          <span class="config-model-dot"></span>
          <span>${m}</span>
        </div>`
      ).join('');
    }
  }

  document.querySelectorAll<HTMLElement>('.config-card').forEach(card => {
    const select = card.querySelector<HTMLSelectElement>('.config-select');
    if (!select) return;

    const configs: Array<{label:string;price:number;models:string[];note:string}>
      = JSON.parse(select.dataset.configs || '[]');

    // Initialise with first config
    if (configs.length > 0) {
      renderModels(card, configs[0].models, configs[0].note, configs[0].price);
    }

    select.addEventListener('change', () => {
      const cfg = configs[select.selectedIndex];
      if (cfg) renderModels(card, cfg.models, cfg.note, cfg.price);
    });
  });

  // Mouse-tracking glow
  document.querySelectorAll<HTMLElement>('.glow-card').forEach(card => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${((e.clientX-r.left)/r.width)*100}%`);
      card.style.setProperty('--mouse-y', `${((e.clientY-r.top)/r.height)*100}%`);
    });
  });
</script>
