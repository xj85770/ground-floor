---
import Base from '../layouts/Base.astro';
import { page, breadcrumb } from '../lib/seo';
import { memoryOptions, memoryTier } from '../lib/explorer';
const schema=[page('WebPage',{site:Astro.site,path:'/hardware',name:'Mac memory guide for local AI',description:'A cautious Apple-silicon unified-memory guide for local model planning.'}),breadcrumb(Astro.site,[{name:'Ground Floor',path:'/'},{name:'Mac memory guide',path:'/hardware'}])];
---
<Base title="Mac memory guide for local AI" description="A cautious Apple-silicon unified-memory guide for local model planning." appearance="light" schema={schema}>
  <header class="gf-page-hero"><div class="gf-shell"><p class="gf-eyebrow">Hardware reference</p><h1 class="gf-display mt-4">How does Mac memory change local-model fit?</h1><p class="gf-lede">Unified memory is the first planning constraint. It is not the whole performance story: chip, artifact, runtime, context, cache, and open applications still matter.</p><a class="gf-button inline-flex mt-7" href="/setup">Enter my exact build</a></div></header>
  <section class="gf-content"><div class="gf-shell"><div class="gf-section-head"><p class="gf-eyebrow">Estimate—not benchmark</p><h2 class="gf-h2 mt-3">Cautious Q4 planning ranges</h2><p class="gf-copy">These amounts span Apple-silicon Macs across generations and product families. They do not imply every configuration is sold on every current Mac.</p></div><div class="gf-reference-table" role="table" aria-label="Unified memory planning ranges"><div class="gf-reference-row gf-reference-head" role="row"><span role="columnheader">Unified memory</span><span role="columnheader">Cautious range</span><span role="columnheader">Planning note</span></div>{memoryOptions.map(gb=>{const tier=memoryTier(gb);return <a class="gf-reference-row" role="row" href={`/setup#memory=${gb}`}><strong role="cell">{gb} GB</strong><span role="cell">{tier.range}</span><span role="cell">{tier.detail}</span></a>})}</div><p class="gf-source-line">Current hardware reference checked July 19, 2026: <a href="https://support.apple.com/en-us/126319">Apple’s 16-inch M5 Pro/Max specifications</a> list 24, 36, 48, 64, and 128 GB configurations depending on chip/GPU. Older and custom amounts remain in the explorer for Macs across generations.</p></div></section>
</Base>
