          {industriesForStage.map((ind, i) => (
            <button
              class="sm-tab"
              data-idx={String(i)}
              style={`display:flex;flex-direction:column;gap:4px;padding:12px 14px;border-radius:10px;border:1px solid ${i === 0 ? '#9b5de5' : '#2a2a2d'};background:${i === 0 ? 'rgba(155,93,229,0.12)' : 'rgba(255,255,255,0.02)'};cursor:pointer;text-align:left;transition:all 0.18s;position:relative;`}
