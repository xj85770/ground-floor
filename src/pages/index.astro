              <span class="sm-pulse-dot" style={`position:absolute;top:10px;right:10px;width:5px;height:5px;border-radius:50%;background:#9b5de5;animation:pulse 2s ease-in-out infinite;display:${i === 0 ? 'block' : 'none'};`}></span>
              <span style={`font-family:'JetBrains Mono',monospace;font-size:0.75rem;color:${i === 0 ? '#9b5de5' : '#6e6e73'};`}>{ind.icon}</span>
              <span style={`font-family:'JetBrains Mono',monospace;font-size:0.6rem;letter-spacing:0.12em;text-transform:uppercase;color:${i === 0 ? '#9b5de5' : '#a1a1a6'};`}>{ind.shortName}</span>
              {ind.experimentCount > 0 && (
                <span style="font-family:'JetBrains Mono',monospace;font-size:0.55rem;color:#424245;">{ind.experimentCount} exp.</span>
              )}
            </button>
