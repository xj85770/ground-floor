---
import Base from '../layouts/Base.astro';
import ExperimentCard from '../components/ExperimentCard.astro';
import IndustryCard from '../components/IndustryCard.astro';
import { getCollection } from 'astro:content';

const allExperiments = await getCollection('experiments');
const allIndustries  = await getCollection('industries');

const sorted = allExperiments.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const latest = sorted.slice(0, 3);

const expCountByIndustry = allExperiments.reduce<Record<string, number>>((acc, e) => {
  acc[e.data.industry] = (acc[e.data.industry] ?? 0) + 1;
  return acc;
}, {});
---

<Base title="Ground Floor">

  <!-- ═══ HERO — clean, spacious, single statement ═══ -->
  <section class="relative overflow-hidden" style="min-height:96vh;display:flex;align-items:center;justify-content:center;">

    <!-- Single centered glow orb -->
    <div aria-hidden="true" style="
      position:absolute;top:50%;left:50%;
      transform:translate(-50%,-55%);
      width:900px;height:700px;
      background:radial-gradient(ellipse at center,rgba(155,93,229,0.22) 0%,rgba(67,97,238,0.1) 40%,transparent 70%);
      filter:blur(40px);
      pointer-events:none;
      animation:orb-drift 14s ease-in-out infinite;
    "></div>

    <!-- Content — centered, nothing competing with it -->
    <div class="relative text-center max-w-4xl mx-auto px-5 md:px-10">

      <h1 class="font-display font-semibold tracking-tight leading-[1.03] mb-8"
          style="font-size:clamp(3.2rem,8vw,6rem);">
        <span class="hero-line" style="--d:0.1s">
          <span class="gradient-text-animated">Air-gapped AI</span>
        </span>
        <br />
        <span class="hero-line" style="--d:0.28s">
          <span class="text-chalk">for regulated practices.</span>
        </span>
      </h1>

      <p class="hero-line text-xl md:text-2xl text-silver leading-relaxed max-w-2xl mx-auto mb-12"
         style="--d:0.46s;">
        Open-weight models that run on hardware you own. No data leaves the building. No vendor dependency.
      </p>

      <div class="hero-line flex flex-wrap justify-center gap-4" style="--d:0.6s;">
        <a href={`/experiments/${latest[0]?.slug ?? '/experiments'}`} class="btn-primary text-base px-8 py-3.5">
          See the experiments →
        </a>
        <a href="/industries" class="btn-ghost text-base px-8 py-3.5">
          Find your industry
        </a>
      </div>
    </div>

    <!-- Scroll cue -->
    <div class="hero-line absolute bottom-10 left-1/2 -translate-x-1/2" style="--d:1s;">
      <div style="width:1px;height:48px;background:linear-gradient(to bottom,transparent,rgba(255,255,255,0.3));margin:0 auto;animation:scroll-cue 2s ease-in-out infinite;"></div>
    </div>
  </section>


  <!-- ═══ PROOF STRIP ═══ -->
  <div style="border-top:1px solid #424245;border-bottom:1px solid #424245;background:#0a0a0a;">
    <div class="max-w-wide mx-auto px-5 md:px-10 py-5 flex flex-wrap items-center justify-center gap-3 md:gap-6">
      {[
        ['M5 Max × 2 nodes', '#9b5de5'],
        ['256 GB unified memory', '#a1a1a6'],
        ['4 TB storage', '#a1a1a6'],
        ['TB5 RDMA · 3 µs latency', '#a1a1a6'],
        ['100% on-premise', '#34d399'],
      ].map(([label, color]) => (
        <span class="font-mono text-[0.72rem] tracking-wide" style={`color:${color};`}>{label}</span>
      ))}
    </div>
  </div>


  <!-- ═══ THE CASE ═══ -->
  <section style="background:#000;">
    <div class="max-w-wide mx-auto px-5 md:px-10 py-24 md:py-36">

      <div class="reveal text-center mb-20">
        <p class="font-mono text-[0.7rem] tracking-[0.2em] uppercase text-ash mb-5">The architecture argument</p>
        <h2 class="font-display font-semibold tracking-tight text-chalk max-w-3xl mx-auto"
            style="font-size:clamp(1.9rem,4vw,3rem);line-height:1.1;">
          The cloud API is the weakest link.
        </h2>
        <p class="text-silver text-lg mt-5 max-w-xl mx-auto leading-relaxed">
          Every API call is a data flow that exits your building. Air-gapped AI eliminates that exposure category entirely — no third-party processors, no breach surface, no vendor dependency to audit.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {[
          {
            num: '01',
            title: 'No API calls',
            body: 'The model runs on hardware you own. Zero network requests leave your building. No third-party processors, no vendor security posture to audit.',
            color: '#9b5de5',
          },
          {
            num: '02',
            title: 'No breach surface',
            body: "Patient transcripts, client documents, financial records — none of it can appear in a vendor's incident notification. It never left.",
            color: '#4361ee',
          },
          {
            num: '03',
            title: 'No lock-in',
            body: 'Open weights run on open hardware. Switch models, upgrade hardware, or change tools without renegotiating a vendor agreement.',
            color: '#4cc9f0',
          },
        ].map(({ num, title, body, color }) => (
          <div class="reveal glow-card p-8 md:p-10">
            <p class="font-mono text-[0.65rem] tracking-widest uppercase mb-6" style={`color:${color};`}>{num}</p>
            <h3 class="font-display font-semibold text-xl text-chalk mb-4">{title}</h3>
            <p class="text-sm text-silver leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ THE LAB ═══ -->
  <section style="border-top:1px solid #424245;background:#000;">
    <div class="max-w-wide mx-auto px-5 md:px-10 py-24 md:py-36">

