        <!-- Connector -->
        <div class="lab-connector" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:9px;padding:0 6px;margin-top:-30px;">
          <svg width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
