      <p class="reveal font-mono text-[0.7rem] tracking-[0.2em] uppercase text-ash mb-8">June 2026</p>
      <h2 class="reveal font-display font-semibold tracking-tight text-chalk mb-6"
          style="font-size:clamp(2.2rem,5vw,4rem);line-height:1.05;">The question is answered.</h2>
      <p class="reveal text-xl text-silver leading-relaxed mb-14">
        An M5 Max Mac runs a 70B parameter model faster than most cloud API round-trips.
        On hardware you own. With data that never leaves.
        I wasn't certain this was practical two years ago. It is now.
      </p>
      <div class="reveal flex flex-wrap items-center justify-center gap-4">
        <a href="/experiments" class="btn-primary text-base px-8 py-3.5">Explore experiments</a>
        <a href="/playbook"    class="btn-ghost   text-base px-8 py-3.5">Read the playbook</a>
      </div>
    </div>
  </section>

</Base>

<style>
  .hero-line {
    display:block;
    opacity:0;
    transform:translateY(28px);
    animation:hero-reveal 0.9s cubic-bezier(0.22,1,0.36,1) var(--d,0s) forwards;
  }
  @keyframes sm-stage-in {
    from { opacity:0; transform:translateY(6px) scale(0.997); }
    to   { opacity:1; transform:translateY(0)   scale(1); }
  }
  @media (max-width: 640px) {
    #sm-root { grid-template-columns: 1fr !important; }
    #sm-tabs { flex-direction: row !important; flex-wrap: wrap; }
    .sm-tab  { flex: 1 1 calc(50% - 4px); }
  }
  @keyframes hero-reveal {
    to { opacity:1; transform:translateY(0); }
  }
  @keyframes scroll-cue {
    0%,100% { opacity:0.2; transform:scaleY(0.8); }
    50%      { opacity:0.7; transform:scaleY(1.1); }
  }
  @keyframes pulse {
    0%,100% { opacity:1; }
    50%      { opacity:0.35; }
  }
  .hero-split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  @media (max-width: 768px) {
    .hero-split-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-split-grid > div:last-child { display: none; }
  }

  /* lab floating animations */
  .lab-float-a { animation: lab-float-a 3.8s ease-in-out infinite; }
  .lab-float-b { animation: lab-float-b 3.8s ease-in-out infinite; }
  @keyframes lab-float-a {
    0%, 100% { transform: translateY(0px); }
    50%      { transform: translateY(-10px); }
  }
  @keyframes lab-float-b {
    0%, 100% { transform: translateY(-5px); }
    50%      { transform: translateY(5px); }
  }

  /* lab glow */
  .lab-glow-a {
    filter:
      drop-shadow(0 0 14px rgba(155,93,229,0.55))
      drop-shadow(0 12px 28px rgba(155,93,229,0.25))
      drop-shadow(0 0 60px rgba(155,93,229,0.1));
    transition: filter 0.4s;
  }
  .lab-glow-a:hover {
    filter:
      drop-shadow(0 0 22px rgba(155,93,229,0.9))
      drop-shadow(0 12px 36px rgba(155,93,229,0.4))
      drop-shadow(0 0 80px rgba(155,93,229,0.2));
  }
  .lab-glow-b {
    filter:
      drop-shadow(0 0 14px rgba(67,97,238,0.55))
      drop-shadow(0 12px 28px rgba(67,97,238,0.25))
      drop-shadow(0 0 60px rgba(67,97,238,0.1));
    transition: filter 0.4s;
  }
  .lab-glow-b:hover {
    filter:
      drop-shadow(0 0 22px rgba(67,97,238,0.9))
      drop-shadow(0 12px 36px rgba(67,97,238,0.4))
      drop-shadow(0 0 80px rgba(67,97,238,0.2));
  }

  /* lab section connector */
  .lab-connector-line {
    width: 100%;
    height: 1px;
    position: relative;
    background: linear-gradient(
      to right,
      rgba(155,93,229,0.7),
      rgba(155,93,229,0.35) 20%,
      rgba(200,200,255,0.2) 50%,
      rgba(67,97,238,0.35) 80%,
      rgba(67,97,238,0.7)
    );
    box-shadow: 0 0 4px rgba(155,93,229,0.3), 0 0 8px rgba(67,97,238,0.2);
    overflow: visible;
  }
  /* left→right pulse */
  .lab-connector-line::before {
    content: '';
    position: absolute;
    top: -1.5px;
    width: 20%;
    height: 4px;
    border-radius: 3px;
    background: linear-gradient(to right, transparent, rgba(255,255,255,0.85), transparent);
    animation: lab-pulse-ltr 2.8s ease-in-out infinite;
  }
  /* right→left pulse, offset by half cycle */
  .lab-connector-line::after {
    content: '';
    position: absolute;
    top: -1.5px;
    width: 20%;
    height: 4px;
    border-radius: 3px;
    background: linear-gradient(to left, transparent, rgba(255,255,255,0.85), transparent);
    animation: lab-pulse-rtl 2.8s ease-in-out infinite 1.4s;
  }
  @keyframes lab-pulse-ltr {
    0%   { left: -20%; opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  @keyframes lab-pulse-rtl {
    0%   { left: 120%; opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { left: -20%; opacity: 0; }
  }

  /* ── responsive ── */

  /* tablet: shrink SVGs so both fit side-by-side */
  @media (max-width: 860px) {
    .lab-float-a > svg,
    .lab-float-b > svg {
      width: 155px;
      height: auto;
    }
    .lab-connector { margin-top: -18px !important; }
  }

  /* mobile: stack vertically */
  @media (max-width: 600px) {
    .lab-cluster {
      flex-direction: column !important;
      align-items: center !important;
    }
    .lab-float-a > svg,
    .lab-float-b > svg {
      width: min(220px, 72vw);
      height: auto;
    }
    /* connector becomes a compact horizontal row between stacked laptops */
    .lab-connector {
      flex: none !important;
      flex-direction: row !important;
      width: min(300px, 80vw);
      margin-top: 0 !important;
      padding: 6px 0 !important;
      gap: 10px !important;
    }
    .lab-connector-line { flex: 1; }
    /* hide the label on mobile to keep it tight */
    .lab-connector p { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.glow-card').forEach(card => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${((e.clientX-r.left)/r.width)*100}%`);
      card.style.setProperty('--mouse-y', `${((e.clientY-r.top)/r.height)*100}%`);
    });
  });
</script>
