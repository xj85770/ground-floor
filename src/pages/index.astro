---
import Base from '../layouts/Base.astro';
import ExperimentCard from '../components/ExperimentCard.astro';
import IndustryCard from '../components/IndustryCard.astro';
import Faq from '../components/Faq.astro';
import { getCollection } from 'astro:content';

// FAQ — self-contained citable atoms (verified facts only), drafted via the xavier-script
// skill and passed through slop-scan (grade A) + agent-seo (94.5/100). Doubles as FAQPage schema.
const faq = [
  { q: 'What is Ground Floor?', a: "Ground Floor is an independent project documenting air-gapped, open-weight AI for regulated practices: legal, medical, financial, and accounting. The models run on hardware you own. There are no API calls and no vendor agreements, so the data that goes in stays in. Every week I run a real experiment and publish the honest verdict, including the ones that are not ready yet." },
  { q: 'Can you run a large language model locally without sending data to the cloud?', a: "Yes. Ground Floor runs open-weight models entirely on your own machine, so there is no API call and no copy of your data on a vendor's server. For a clinic or a law firm, that is the point: patient records and privileged files never leave the building. The trade is that you run your own hardware instead of renting someone else's." },
  { q: 'What hardware do you need to run a capable local model?', a: "Less than most people expect. Small open-weight models run on any modern Mac, and mid-size ones want roughly 32 to 128 GB of memory. The Ground Floor lab uses two M5 Max MacBook Pros with 256 GB of combined memory, but that is deliberately overbuilt so I can test the ceiling. The Will-It-Run tool gives you the honest answer for your specific Mac." },
  { q: 'Is a local model actually fast enough to be useful?', a: "In my Ground Floor testing, yes, for the work regulated practices actually do: drafting notes, summarizing documents, checking a contract clause. An M5 Max runs a 70B-parameter model faster than most cloud API round-trips, on hardware you own. It will not beat a frontier cloud model on the hardest reasoning, and I say so on each experiment. For everyday drafting, the gap that matters has closed." },
  { q: 'Open-weight local model or a cloud API for regulated data?', a: "For data that cannot leave the building, such as PHI, privileged legal files, or financial records, a local open-weight model like Ground Floor avoids the thing a cloud API cannot: your data leaving your control and sitting with a third party. A cloud API is often more capable on raw reasoning, so the real question is whether the data is allowed to leave at all. If it is not, local is the honest answer. And running locally does not make you HIPAA-compliant by itself; it removes one large exposure, not all of them." },
];

const allExperiments = await getCollection('experiments');
const allIndustries  = await getCollection('industries');

const sorted = allExperiments.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const latest = sorted.slice(0, 3);

const expCountByIndustry = allExperiments.reduce<Record<string, number>>((acc, e) => {
  acc[e.data.industry] = (acc[e.data.industry] ?? 0) + 1;
  return acc;
}, {});

const industryIcons: Record<string, string> = {
  medical: '✚', legal: '§', financial: '$', accounting: '∑',
};

const industriesForStage = allIndustries.map(ind => ({
  slug: ind.slug,
  shortName: ind.data.shortName,
  name: ind.data.name,
  whyLocal: ind.data.whyLocal,
  commonUseCases: ind.data.commonUseCases,
  maturityNote: ind.data.maturityNote,
  regulation: ind.data.regulation,
  experimentCount: expCountByIndustry[ind.slug] ?? 0,
  icon: industryIcons[ind.slug] ?? '◆',
}));
---

<Base title="Ground Floor">

  <!-- ═══ HERO — split: copy left, leaderboard card right ═══ -->
  <section class="relative overflow-hidden" style="min-height:92vh;display:flex;align-items:center;">

    <!-- Aurora glow — right-biased -->
    <div aria-hidden="true" style="
      position:absolute;top:-100px;right:-10%;
      width:70%;height:700px;
      background:radial-gradient(ellipse 80% 70% at 80% 30%,rgba(155,93,229,0.22) 0%,rgba(67,97,238,0.1) 50%,transparent 70%);
      pointer-events:none;
      animation:orb-drift 14s ease-in-out infinite;
    "></div>

    <div class="relative w-full max-w-7xl mx-auto px-5 md:px-10 py-24 hero-split-grid">

      <!-- Left: copy -->
      <div>
        <p class="hero-line font-mono text-[0.65rem] tracking-[0.2em] uppercase mb-4" style="--d:0.05s;color:#9b5de5;">Ground Floor · Models</p>

        <h1 class="hero-line font-display font-bold tracking-tight leading-[1.08] mb-6" style="--d:0.1s;font-size:clamp(2.4rem,4vw,3.4rem);">
          Air-gapped AI<br/>
          <span class="gradient-text-animated">for regulated practices.</span>
        </h1>

        <p class="hero-line text-lg text-silver leading-relaxed mb-10" style="--d:0.28s;max-width:440px;">
          Open-weight models running on hardware you own. No API calls. No vendor agreements. The data that goes in stays in.
        </p>

        <div class="hero-line flex flex-wrap gap-3 mb-10" style="--d:0.42s;">
          <a href="/models" class="btn-primary text-base px-7 py-3">Open the leaderboard →</a>
          <a href="/will-it-run" class="btn-ghost text-base px-7 py-3">Will it run on my Mac? →</a>
          <a href="/hardware" class="btn-ghost text-base px-7 py-3">Hardware guide</a>
        </div>

        <!-- RAM tier legend -->
        <div class="hero-line" style="--d:0.54s;padding-top:20px;border-top:1px solid #2a2a2d;">
          <p class="font-mono text-[0.58rem] tracking-[0.15em] uppercase mb-3" style="color:#6e6e73;">RAM color guide</p>
          <div style="display:flex;flex-wrap:wrap;gap:7px;">
            {[
              ['≤ 36 GB · any Mac',     '#34d399','rgba(52,211,153,0.10)','rgba(52,211,153,0.25)'],
              ['≤ 128 GB · M5 Max',     '#a78bfa','rgba(167,139,250,0.12)','rgba(167,139,250,0.3)'],
              ['≤ 244 GB · cluster',    '#4cc9f0','rgba(76,201,240,0.10)','rgba(76,201,240,0.25)'],
              ['> 244 GB · bigger cluster','#fb923c','rgba(251,146,60,0.10)','rgba(251,146,60,0.25)'],
            ].map(([label, color, bg, border]) => (
              <span class="font-mono" style={`font-size:0.6rem;padding:3px 9px;border-radius:4px;color:${color};background:${bg};border:1px solid ${border};`}>{label}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: floating leaderboard card -->
      <div class="hero-line" style="--d:0.32s;">
        <div style="background:#0a0a0d;border:1px solid #424245;border-radius:16px;overflow:hidden;box-shadow:0 0 60px rgba(155,93,229,0.12),0 4px 32px rgba(0,0,0,0.6);">

          <!-- Card header -->
          <div style="padding:13px 16px;border-bottom:1px solid #2a2a2d;background:rgba(255,255,255,0.02);display:flex;align-items:center;justify-content:space-between;">
            <span class="font-mono text-[0.58rem] tracking-[0.15em] uppercase" style="color:#6e6e73;">Open-weight leaderboard · 24 models</span>
            <span style="width:6px;height:6px;border-radius:50%;background:#9b5de5;animation:pulse 2s ease-in-out infinite;display:inline-block;"></span>
          </div>

          <!-- Mini table -->
          <div style="position:relative;">
            <table style="width:100%;border-collapse:collapse;font-family:'JetBrains Mono','SF Mono',monospace;font-size:0.7rem;">
              <thead>
                <tr style="border-bottom:1px solid #2a2a2d;background:rgba(255,255,255,0.015);">
                  <th style="text-align:left;padding:9px 14px;font-size:0.55rem;letter-spacing:0.18em;text-transform:uppercase;color:#6e6e73;font-weight:500;">Model</th>
                  <th style="text-align:right;padding:9px 14px;font-size:0.55rem;letter-spacing:0.18em;text-transform:uppercase;color:#6e6e73;font-weight:500;">Intel</th>
                  <th style="text-align:right;padding:9px 14px;font-size:0.55rem;letter-spacing:0.18em;text-transform:uppercase;color:#6e6e73;font-weight:500;">Min RAM</th>
                  <th style="text-align:right;padding:9px 14px;font-size:0.55rem;letter-spacing:0.18em;text-transform:uppercase;color:#6e6e73;font-weight:500;">t/s</th>
                </tr>
              </thead>
              <tbody>
                {[
                  { name: 'MiniMax M3',       cluster: true,  intel: 55, ram: '160 GB', ramColor: '#4cc9f0', ramBg: 'rgba(76,201,240,0.10)',  ramBorder: 'rgba(76,201,240,0.25)',  speed: 58 },
                  { name: 'DeepSeek-R1 671B', cluster: true,  intel: 55, ram: '190 GB', ramColor: '#4cc9f0', ramBg: 'rgba(76,201,240,0.10)',  ramBorder: 'rgba(76,201,240,0.25)',  speed: 8  },
                  { name: 'Kimi K2.6',        cluster: false, intel: 54, ram: '360 GB', ramColor: '#fb923c', ramBg: 'rgba(251,146,60,0.10)',  ramBorder: 'rgba(251,146,60,0.25)',  speed: 34 },
                  { name: 'Qwen3.6 27B',      cluster: false, intel: 46, ram: '17 GB',  ramColor: '#34d399', ramBg: 'rgba(52,211,153,0.10)',  ramBorder: 'rgba(52,211,153,0.25)', speed: 66 },
                  { name: 'Mistral Small 4',  cluster: false, intel: 28, ram: '55 GB',  ramColor: '#a78bfa', ramBg: 'rgba(167,139,250,0.12)', ramBorder: 'rgba(167,139,250,0.3)', speed: 172},
                  { name: 'Phi-4 14B',        cluster: false, intel: 30, ram: '10 GB',  ramColor: '#34d399', ramBg: 'rgba(52,211,153,0.10)',  ramBorder: 'rgba(52,211,153,0.25)', speed: 95 },
                  { name: 'Gemma 4 4B',       cluster: false, intel: 24, ram: '3 GB',   ramColor: '#34d399', ramBg: 'rgba(52,211,153,0.10)',  ramBorder: 'rgba(52,211,153,0.25)', speed: 290},
                  { name: 'Granite 4.0 H Small', cluster: false, intel: 11, ram: '20 GB', ramColor: '#34d399', ramBg: 'rgba(52,211,153,0.10)', ramBorder: 'rgba(52,211,153,0.25)', speed: 364},
                ].map((m, i) => (
                  <tr style={`border-bottom:1px solid ${i < 6 ? '#1e1e22' : 'transparent'};${i === 6 ? 'opacity:0.45;' : ''}`}>
                    <td style="padding:9px 14px;color:#e5e5ea;font-weight:500;font-size:0.67rem;">
                      {m.name}
                      {m.cluster && <span style="display:inline-flex;align-items:center;padding:1px 5px;border-radius:3px;font-size:0.52rem;margin-left:5px;color:#4cc9f0;background:rgba(76,201,240,0.08);border:1px solid rgba(76,201,240,0.2);">RDMA</span>}
                    </td>
                    <td style="padding:9px 14px;text-align:right;color:#9b5de5;font-weight:600;">{m.intel}</td>
                    <td style="padding:9px 14px;text-align:right;">
                      <span style={`display:inline-flex;align-items:center;padding:2px 7px;border-radius:4px;font-size:0.58rem;color:${m.ramColor};background:${m.ramBg};border:1px solid ${m.ramBorder};`}>{m.ram}</span>
                    </td>
                    <td style="padding:9px 14px;text-align:right;color:#a1a1a6;">{m.speed}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <!-- Fade mask -->
            <div style="position:absolute;bottom:0;left:0;right:0;height:80px;background:linear-gradient(to bottom,transparent,#0a0a0d);pointer-events:none;"></div>
          </div>

          <!-- Card footer -->
          <div style="padding:11px 16px;border-top:1px solid #1e1e22;display:flex;align-items:center;justify-content:space-between;">
            <span class="font-mono text-[0.58rem]" style="color:#6e6e73;">Showing 8 of 24 · sorted by intelligence</span>
            <a href="/models" class="font-mono text-[0.6rem]" style="color:#9b5de5;text-decoration:none;">Full table →</a>
          </div>
        </div>
      </div>

    </div>

    <!-- Scroll cue -->
    <div class="hero-line absolute bottom-10 left-1/2 -translate-x-1/2" style="--d:1s;">
      <div style="width:1px;height:48px;background:linear-gradient(to bottom,transparent,rgba(255,255,255,0.3));margin:0 auto;animation:scroll-cue 2s ease-in-out infinite;"></div>
    </div>
  </section>


  <!-- ═══ PROOF STRIP ═══ -->
  <div style="border-top:1px solid #424245;border-bottom:1px solid #424245;background:#0a0a0a;">
    <div class="max-w-wide mx-auto px-5 md:px-10 py-5 flex flex-wrap items-center justify-center gap-3 md:gap-6">
      {[
        ['M5 Max × 2 nodes', '#9b5de5'],
        ['256 GB unified memory', '#a1a1a6'],
        ['16 TB storage', '#a1a1a6'],
        ['TB5 RDMA · 3 µs latency', '#a1a1a6'],
        ['100% on-premise', '#34d399'],
      ].map(([label, color]) => (
        <span class="font-mono text-[0.72rem] tracking-wide" style={`color:${color};`}>{label}</span>
      ))}
    </div>
  </div>


  <!-- ═══ THE CASE ═══ -->
  <section style="background:#000;">
    <div class="max-w-wide mx-auto px-5 md:px-10 py-24 md:py-36">

      <div class="reveal text-center mb-20">
        <p class="font-mono text-[0.7rem] tracking-[0.2em] uppercase text-ash mb-5">Why local</p>
        <h2 class="font-display font-semibold tracking-tight text-chalk max-w-3xl mx-auto"
            style="font-size:clamp(1.9rem,4vw,3rem);line-height:1.1;">
          The cloud API is the weakest link.
        </h2>
        <p class="text-silver text-lg mt-5 max-w-xl mx-auto leading-relaxed">
          Something I kept noticing: the practitioners who most need good AI tools are often the ones most exposed by cloud architecture. Every API call routes data somewhere else. For patient records, client files, and financial accounts — that's not a quirk. That's the whole problem. Air-gapped removes it from the equation entirely.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {[
          {
            num: '01',
            title: 'No API calls',
            body: 'The model runs on the machine in front of you. No network call leaves, no vendor handles the data, no API logs it. Inference happens locally — that\'s the whole point.',
            color: '#9b5de5',
          },
          {
            num: '02',
            title: 'No breach surface',
            body: "Patient transcripts, client documents, financial records — none of it appears in a vendor's incident report. It never left your building.",
            color: '#4361ee',
          },
          {
            num: '03',
            title: 'No lock-in',
            body: 'Open weights on open hardware. Swap the model, change the runtime, upgrade the machine — without renegotiating anything.',
            color: '#4cc9f0',
          },
        ].map(({ num, title, body, color }) => (
          <div class="reveal glow-card p-8 md:p-10">
            <p class="font-mono text-[0.65rem] tracking-widest uppercase mb-6" style={`color:${color};`}>{num}</p>
            <h3 class="font-display font-semibold text-xl text-chalk mb-4">{title}</h3>
            <p class="text-sm text-silver leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ THE LAB ═══ -->
  <section style="border-top:1px solid #424245;background:#000;">
    <div class="max-w-wide mx-auto px-5 md:px-10 py-24 md:py-36">

      <div class="reveal mb-16">
        <p class="font-mono text-[0.7rem] tracking-[0.2em] uppercase text-ash mb-4">The hardware</p>
        <h2 class="font-display font-semibold tracking-tight text-chalk"
            style="font-size:clamp(1.75rem,4vw,2.75rem);">The Lab</h2>
        <p class="text-silver mt-3 max-w-xl">
          I have two M5 Max MacBook Pros connected over Thunderbolt 5 RDMA — 256 GB combined memory, 16 TB of storage, ~3 µs between nodes. It's an unreasonably powerful home office setup. But it means every experiment documented here has a specific, real hardware answer.
        </p>
      </div>

      <!-- Laptop cluster visual -->
      <div class="reveal mb-4 lab-cluster" style="display:flex;align-items:center;justify-content:center;gap:0;width:100%;">

        <!-- Node A -->
        <div style="display:flex;flex-direction:column;align-items:center;gap:18px;flex:0 0 auto;">
          <p class="font-mono" style="font-size:0.65rem;letter-spacing:0.18em;text-transform:uppercase;color:#9b5de5;">Node A</p>
          <div class="lab-float-a lab-glow-a">
            <svg width="230" height="175" viewBox="0 0 230 175" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="scrA" x1="0" y1="0" x2="1" y2="1" gradientUnits="objectBoundingBox">
                  <stop offset="0%"   stop-color="#1e0a38"/>
                  <stop offset="35%"  stop-color="#120820"/>
                  <stop offset="100%" stop-color="#06020e"/>
                </linearGradient>
                <radialGradient id="bloomA" cx="50%" cy="55%" r="50%">
                  <stop offset="0%"   stop-color="#9b5de5" stop-opacity="0.22"/>
                  <stop offset="60%"  stop-color="#9b5de5" stop-opacity="0.06"/>
                  <stop offset="100%" stop-color="#9b5de5" stop-opacity="0"/>
                </radialGradient>
                <linearGradient id="lidA" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%"   stop-color="#2a2a2d"/>
                  <stop offset="100%" stop-color="#18181a"/>
                </linearGradient>
                <linearGradient id="baseA" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%"   stop-color="#232325"/>
                  <stop offset="100%" stop-color="#141416"/>
                </linearGradient>
                <linearGradient id="edgeA" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%"   stop-color="#9b5de5" stop-opacity="0"/>
                  <stop offset="40%"  stop-color="#9b5de5" stop-opacity="0.9"/>
                  <stop offset="100%" stop-color="#9b5de5" stop-opacity="0"/>
                </linearGradient>
                <linearGradient id="glareA" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%"   stop-color="white" stop-opacity="0.055"/>
                  <stop offset="40%"  stop-color="white" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <rect x="8" y="4" width="214" height="138" rx="8" fill="url(#lidA)" stroke="#3a3a3c" stroke-width="0.8"/>
              <rect x="14" y="10" width="202" height="126" rx="5" fill="#0c0c0e" stroke="#2a2a2c" stroke-width="0.5"/>
              <rect x="18" y="14" width="194" height="118" rx="4" fill="url(#scrA)"/>
              <rect x="18" y="14" width="194" height="118" rx="4" fill="url(#bloomA)"/>
              <rect x="18" y="14" width="194" height="118" rx="4" fill="url(#glareA)"/>
              <rect x="103" y="5" width="24" height="9" rx="4.5" fill="#111113"/>
              <circle cx="115" cy="9.5" r="2" fill="#1a1a1c"/>
              <circle cx="115" cy="9.5" r="0.8" fill="#252527"/>
              <rect x="18" y="14" width="3.5" height="118" rx="1.75" fill="url(#edgeA)"/>
              <line x1="30" y1="40" x2="110" y2="40" stroke="rgba(155,93,229,0.25)" stroke-width="1" stroke-linecap="round"/>
              <line x1="30" y1="52" x2="145" y2="52" stroke="rgba(155,93,229,0.14)" stroke-width="1" stroke-linecap="round"/>
              <line x1="30" y1="64" x2="88"  y2="64" stroke="rgba(155,93,229,0.2)"  stroke-width="1" stroke-linecap="round"/>
              <line x1="30" y1="76" x2="128" y2="76" stroke="rgba(155,93,229,0.14)" stroke-width="1" stroke-linecap="round"/>
              <line x1="30" y1="88" x2="96"  y2="88" stroke="rgba(155,93,229,0.18)" stroke-width="1" stroke-linecap="round"/>
              <rect x="30" y="98" width="6" height="10" rx="1" fill="rgba(155,93,229,0.7)">
                <animate attributeName="opacity" values="1;0;1" dur="1.1s" repeatCount="indefinite"/>
              </rect>
              <rect x="8" y="140" width="214" height="4" rx="1" fill="#1a1a1c"/>
              <rect x="4" y="143" width="222" height="28" rx="4" fill="url(#baseA)" stroke="#333335" stroke-width="0.6"/>
              <rect x="10" y="147" width="210" height="20" rx="2" fill="#161618"/>
              <g fill="#232325" stroke="#2e2e30" stroke-width="0.4">
                <rect x="14"  y="149" width="12" height="5" rx="1"/>
                <rect x="28"  y="149" width="12" height="5" rx="1"/>
                <rect x="42"  y="149" width="12" height="5" rx="1"/>
                <rect x="56"  y="149" width="12" height="5" rx="1"/>
                <rect x="72"  y="149" width="12" height="5" rx="1"/>
                <rect x="86"  y="149" width="12" height="5" rx="1"/>
                <rect x="100" y="149" width="12" height="5" rx="1"/>
                <rect x="114" y="149" width="12" height="5" rx="1"/>
                <rect x="130" y="149" width="12" height="5" rx="1"/>
                <rect x="144" y="149" width="12" height="5" rx="1"/>
                <rect x="158" y="149" width="12" height="5" rx="1"/>
                <rect x="172" y="149" width="12" height="5" rx="1"/>
                <rect x="186" y="149" width="12" height="5" rx="1"/>
                <rect x="200" y="149" width="16" height="5" rx="1"/>
              </g>
              <g fill="#232325" stroke="#2e2e30" stroke-width="0.4">
                <rect x="14"  y="156" width="12" height="6" rx="1"/>
                <rect x="28"  y="156" width="12" height="6" rx="1"/>
                <rect x="42"  y="156" width="12" height="6" rx="1"/>
                <rect x="56"  y="156" width="12" height="6" rx="1"/>
                <rect x="70"  y="156" width="12" height="6" rx="1"/>
                <rect x="84"  y="156" width="12" height="6" rx="1"/>
                <rect x="98"  y="156" width="12" height="6" rx="1"/>
                <rect x="112" y="156" width="12" height="6" rx="1"/>
                <rect x="126" y="156" width="12" height="6" rx="1"/>
                <rect x="140" y="156" width="12" height="6" rx="1"/>
                <rect x="154" y="156" width="12" height="6" rx="1"/>
                <rect x="168" y="156" width="12" height="6" rx="1"/>
                <rect x="182" y="156" width="34" height="6" rx="1"/>
              </g>
              <rect x="84" y="148" width="62" height="18" rx="3" fill="#1c1c1e" stroke="#2a2a2c" stroke-width="0.5"/>
              <circle cx="20"  cy="169" r="2" fill="#111"/>
              <circle cx="210" cy="169" r="2" fill="#111"/>
              <rect x="200" y="152" width="3" height="12" rx="1.5" fill="#9b5de5" opacity="0.5">
                <animate attributeName="opacity" values="0.5;0.9;0.5" dur="2s" repeatCount="indefinite"/>
              </rect>
            </svg>
          </div>
          <dl style="display:grid;grid-template-columns:1fr 1fr;gap:5px 20px;text-align:center;">
            {[['Chip','M5 Max'],['Memory','128 GB'],['Storage','8 TB NVMe'],['OS','Tahoe 26.2']].map(([k,v]) => (
              <div>
                <dt class="font-mono" style="font-size:0.55rem;letter-spacing:0.14em;text-transform:uppercase;color:#6e6e73;margin-bottom:2px;">{k}</dt>
                <dd style="font-size:0.8rem;color:#f5f5f7;font-weight:500;">{v}</dd>
              </div>
            ))}
          </dl>
        </div>

