---
import Base from '../layouts/Base.astro';
import MacEntrance from '../components/MacEntrance.astro';
import { page, faqPage, breadcrumb } from '../lib/seo';

const faq = [
  { q: 'Does anything get uploaded?', a: 'The checker does not ask for documents. A local setup can keep processing on hardware you control, but your device, backups, access, and network policy still matter.' },
  { q: 'Does local AI make the work compliant?', a: 'No. Local processing changes where the model runs. It does not replace professional review, security controls, recordkeeping, or the rules that apply to your work.' },
  { q: 'Are these recommendations proven?', a: 'Not yet. The checker gives a planning estimate. Ground Floor has published three test protocols, but no completed practitioner study.' },
  { q: 'What should I try first?', a: 'Choose repetitive documentation with known source material, a standard output, and a qualified person who will review the result.' },
];

const schema = [
  page('WebPage', { site: Astro.site, path: '/', name: 'Local AI for sensitive professional work', description: 'Ground Floor helps small professional practices evaluate local AI for narrow, human-reviewed documentation work.' }),
  breadcrumb(Astro.site, [{ name: 'Ground Floor', path: '/' }]),
  faqPage(faq),
];
---

<Base
  title="Local AI for sensitive professional work"
  description="Ground Floor helps small legal, medical, financial, and accounting practices evaluate local AI for narrow documentation tasks on hardware they control."
  appearance="light"
  schema={schema}
>
  <MacEntrance />
  <section class="gf-hero">
    <div class="gf-shell gf-hero-grid">
      <div id="gf-hero-copy" class="gf-hero-copy">
        <p class="gf-eyebrow">Start with one real task</p>
        <h1 class="gf-display mt-4">What work do you want off your plate?</h1>
        <p class="gf-lede mt-6">Choose the work and your Mac’s memory. Get a cautious local-AI starting point immediately.</p>
        <div class="gf-hero-actions">
          <button id="gf-start-checker" class="gf-button" type="button" aria-controls="workflows">Get my answer</button>
          <a class="gf-button gf-button-secondary" href="/experiments">View the evidence</a>
          <button id="gf-replay-entrance" class="gf-replay-entrance" type="button">Replay opening</button>
        </div>
        <p class="gf-boundary">For first drafts and document work. A qualified person keeps the final say.</p>
      </div>

      <form id="workflows" class="gf-checker" aria-labelledby="quick-check-title" novalidate>
        <div class="gf-checker-head">
          <strong id="quick-check-title">Find your starting point</strong>
          <span id="gf-checker-status" class="gf-status">2 questions</span>
        </div>
        <div id="gf-walkthrough" class="gf-walkthrough" aria-live="polite" hidden>
          <div>
            <p id="gf-walkthrough-step" class="gf-reading-label">Step 1 of 2</p>
            <p id="gf-walkthrough-text">Start with the work you want to make easier.</p>
          </div>
          <div class="gf-walkthrough-actions">
            <button id="gf-walkthrough-next" class="gf-button" type="button">Next: choose memory</button>
            <button id="gf-walkthrough-close" class="gf-walkthrough-close" type="button">Exit guide</button>
          </div>
        </div>
        <div class="gf-checker-form">
          <div id="gf-task-field" class="gf-field">
            <label for="home-task">Which task wastes your time?</label>
            <select id="home-task" required>
              <option value="" selected disabled>Choose a task…</option>
              <option value="meeting">Turn meeting notes into a clean record</option>
              <option value="draft">Draft from approved source notes</option>
              <option value="review">Spot issues before full contract review</option>
              <option value="intake">Put intake into our standard format</option>
            </select>
          </div>
          <div id="gf-memory-field" class="gf-field">
            <label for="home-memory">How much memory does your Mac have?</label>
            <select id="home-memory">
              <option value="8">8 GB</option>
              <option value="16" selected>16 GB</option>
              <option value="18">18 GB</option>
              <option value="24">24 GB</option>
              <option value="32">32 GB</option>
              <option value="36">36 GB</option>
              <option value="48">48 GB</option>
              <option value="64">64 GB</option>
              <option value="96">96 GB</option>
              <option value="128">128 GB</option>
              <option value="192">192 GB</option>
              <option value="custom">Other amount…</option>
            </select>
            <div id="home-memory-custom-wrap" class="mt-3" hidden>
              <label for="home-memory-custom">Enter unified memory in GB</label>
              <input id="home-memory-custom" type="number" min="8" max="512" step="1" value="64" inputmode="numeric" />
            </div>
            <span class="text-[11px] text-[#63707a] mt-1">Apple menu → About This Mac → Memory</span>
          </div>
        </div>
        <div class="gf-checker-submit">
          <button id="gf-submit-answer" class="gf-button" type="submit" disabled>Show my starting point</button>
          <span>Nothing is uploaded. This estimate runs in your browser.</span>
        </div>
        <p id="gf-result-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
        <div id="gf-answer-reading" class="gf-reading" hidden>
          <div class="gf-reading-top">
            <div>
              <p class="gf-reading-label">Your starting point</p>
              <h2 id="home-reading-title" tabindex="-1">Yes—start with a small local model for meeting notes.</h2>
            </div>
          </div>
          <dl class="gf-reading-grid">
            <div><dt>Run</dt><dd id="home-fit">A 7–9B model should fit. Long documents use more memory.</dd></div>
            <div><dt>Check</dt><dd id="home-review">Verify names, dates, figures, and action owners.</dd></div>
            <div><dt>Proof</dt><dd>Planning estimate. Practitioner study not completed.</dd></div>
          </dl>
          <p class="gf-reading-note" id="home-limit">This is a place to start—not a promise of quality, speed, security, or compliance.</p>
          <div class="flex flex-wrap gap-5 items-center mt-4">
            <a id="home-setup-link" class="gf-link inline-flex" href="/setup#task=draft&memory=16">Show me the setup steps</a>
            <button id="gf-restart-guide" class="gf-walkthrough-restart" type="button">Try another task</button>
          </div>
        </div>
      </form>
    </div>
  </section>

  <section class="gf-section gf-section-white">
    <div class="gf-shell gf-evidence-summary">
      <div class="gf-evidence-count">
        <strong>01</strong>
        <span>one complete reference page</span>
      </div>
      <div>
        <p class="gf-eyebrow">For the real nerds</p>
        <h2 class="gf-h2 mt-3">Want the architecture, memory math, model language, risks, and testing method?</h2>
        <p class="gf-copy mt-4">The homepage gives you the useful answer first. The deep dive keeps the fuller research in one place, with a table of contents and clear labels for measured results, estimates, and unfinished protocols.</p>
        <a class="gf-button inline-flex mt-6" href="/learn">Open the deep dive</a>
      </div>
    </div>
  </section>

  <section class="gf-section gf-section-soft">
    <div class="gf-shell">
      <div class="gf-section-head">
        <p class="gf-eyebrow">The whole story</p>
        <h2 class="gf-h2 mt-3">What you gain—and what you still own.</h2>
      </div>
      <div class="gf-boundary-grid">
        <div>
          <h3>Your files can stay closer</h3>
          <ul>
            <li>Process documents on hardware you control.</li>
            <li>Choose the model, runtime, and network policy.</li>
          </ul>
        </div>
        <div>
          <h3>Your judgment stays essential</h3>
          <ul>
            <li>Review every important fact and conclusion.</li>
            <li>Security, records, and professional rules still apply.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="gf-section gf-section-white">
    <div class="gf-shell gf-evidence-summary">
      <div class="gf-evidence-count">
        <strong>3</strong>
        <span>published test protocols</span>
      </div>
      <div>
        <p class="gf-eyebrow">Proof before promises</p>
        <h2 class="gf-h2 mt-3">The test plans are public. The results are not invented.</h2>
        <p class="gf-copy mt-4">No practitioner study is complete yet. Until Ground Floor retains the setup, inputs, outputs, timing, errors, and reviewer score, the recommendation stays an estimate.</p>
        <a class="gf-link inline-flex mt-5" href="/experiments">See what has—and has not—been tested</a>
      </div>
    </div>
  </section>

  <section class="gf-section gf-section-soft" aria-labelledby="faq-heading">
    <div class="gf-shell">
      <div class="gf-section-head"><h2 id="faq-heading" class="gf-h2">Before you try it</h2></div>
      <div class="gf-task-list">
        {faq.map(item => <details class="border-b border-[#d5dce0] py-5"><summary class="cursor-pointer text-[17px] font-semibold">{item.q}</summary><p class="gf-copy mt-3 max-w-3xl">{item.a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="gf-cta">
    <div class="gf-shell gf-cta-grid">
      <div>
        <h2 class="gf-h2">Have a task the checker missed?</h2>
        <p class="gf-copy">Describe the work without sending confidential information. We’ll tell you whether it is a responsible test candidate.</p>
      </div>
      <a class="gf-button" href="/pilot">Tell us the task</a>
    </div>
  </section>

  <script>
    const task = document.getElementById('home-task') as HTMLSelectElement | null;
    const memory = document.getElementById('home-memory') as HTMLSelectElement | null;
    const customMemory = document.getElementById('home-memory-custom') as HTMLInputElement | null;
    const customWrap = document.getElementById('home-memory-custom-wrap');
    const title = document.getElementById('home-reading-title');
    const fit = document.getElementById('home-fit');
    const review = document.getElementById('home-review');
    const link = document.getElementById('home-setup-link') as HTMLAnchorElement | null;
    const startButton = document.getElementById('gf-start-checker') as HTMLButtonElement | null;
    const checker = document.getElementById('workflows');
    const checkerStatus = document.getElementById('gf-checker-status');
    const guide = document.getElementById('gf-walkthrough');
    const guideStep = document.getElementById('gf-walkthrough-step');
    const guideText = document.getElementById('gf-walkthrough-text');
    const guideNext = document.getElementById('gf-walkthrough-next') as HTMLButtonElement | null;
    const guideClose = document.getElementById('gf-walkthrough-close') as HTMLButtonElement | null;
    const restartGuide = document.getElementById('gf-restart-guide') as HTMLButtonElement | null;
    const submitAnswer = document.getElementById('gf-submit-answer') as HTMLButtonElement | null;
    const resultStatus = document.getElementById('gf-result-status');
    const taskField = document.getElementById('gf-task-field');
    const memoryField = document.getElementById('gf-memory-field');
    const answerReading = document.getElementById('gf-answer-reading');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let guideStage = 0;

    const taskData = {
      meeting: { label:'meeting notes', task:'meeting', review:'Verify names, figures, dates, promises, and action owners.', target:9 },
      draft: { label:'a first draft', task:'draft', review:'Verify every factual statement and remove unsupported additions.', target:9 },
      review: { label:'document triage', task:'review', review:'Complete professional review remains mandatory; check omissions and cross-references.', target:27 },
      intake: { label:'an intake summary', task:'summarize', review:'Check omissions, negations, identities, dates, and sensitive fields.', target:14 },
    } as const;
    function memoryPlan(gb: number) {
      if (gb < 12) return { model:'a 3–4B', max:4, fit:'Start around 3–4B. Keep context short and close other memory-heavy apps.' };
      if (gb < 22) return { model:'a 7–9B', max:9, fit:'A 7–9B model is the cautious range. Long documents use more memory.' };
      if (gb < 30) return { model:'up to a 14B', max:14, fit:'Up to 14B is a cautious range. Test the exact artifact and document length.' };
      if (gb < 36) return { model:'up to a 20B', max:20, fit:'Up to roughly 20B may fit at Q4. Runtime and context still matter.' };
      if (gb < 48) return { model:'up to a 27B', max:27, fit:'Up to 27B is plausible at Q4. Runtime and document length still matter.' };
      if (gb < 64) return { model:'up to a 32B', max:32, fit:'Up to 32B is a cautious Q4 planning range. Verify the exact artifact.' };
      if (gb < 96) return { model:'up to a 40B', max:40, fit:'Larger Q4 models are plausible, but leave room for macOS, context, and the runtime.' };
      return { model:'up to a 70B', max:70, fit:'A 70B-class Q4 artifact may fit. Quality, context, and speed still need direct measurement.' };
    }

    function updateReading() {
      if (!task || !memory || !title || !fit || !review || !link) return;
      const t = taskData[task.value as keyof typeof taskData];
      if (!t) return;
      const memoryGb = memory.value === 'custom' ? Number(customMemory?.value || 8) : Number(memory.value);
      const m = memoryPlan(memoryGb);
      const constrained = m.max < t.target;
      title.textContent = constrained ? `Start smaller—this Mac is tight for ${t.label}.` : `Yes—start with ${m.model} local model for ${t.label}.`;
      fit.textContent = m.fit;
      review.textContent = t.review;
      link.href = `/setup#task=${t.task}&memory=${memoryGb}`;
    }

    function setGuideStage(stage: 1 | 2) {
      if (!guide || !guideStep || !guideText || !guideNext || !task || !memory) return;
      guideStage = stage;
      guide.hidden = false;
      taskField?.classList.toggle('is-guide-focus', stage === 1);
      memoryField?.classList.toggle('is-guide-focus', stage === 2);
      if (checkerStatus) checkerStatus.textContent = `${stage} of 2`;
      if (stage === 1) {
        guideStep.textContent = 'Step 1 of 2 · The work';
        guideText.textContent = 'Choose the real task you want to make easier. Keep the final review with a qualified person.';
        guideNext.textContent = 'Next: choose memory';
        guideNext.disabled = !task.value;
        task.focus({ preventScroll:true });
      } else {
        guideStep.textContent = 'Step 2 of 2 · Your Mac';
        guideText.textContent = 'Choose the unified memory shown in Apple menu → About This Mac. This sets the cautious model range.';
        guideNext.textContent = 'Show my answer';
        guideNext.disabled = false;
        memory.focus({ preventScroll:true });
      }
    }

    function startGuide() {
      if (!checker || !guide) return;
      answerReading?.classList.remove('is-answer-ready');
      if (answerReading) answerReading.hidden = true;
      checker.classList.add('is-guided');
      checker.classList.remove('has-answer');
      document.getElementById('gf-hero-copy')?.classList.add('is-guiding');
      guide.hidden = false;
      checker.scrollIntoView({ behavior:reducedMotion.matches ? 'auto' : 'smooth', block:'center' });
      window.setTimeout(() => setGuideStage(1), reducedMotion.matches ? 0 : 420);
    }

    function finishGuide() {
      if (!guide || !title || !task?.value) {
        setGuideStage(1);
        return;
      }
      guideStage = 0;
      guide.hidden = true;
      taskField?.classList.remove('is-guide-focus');
      memoryField?.classList.remove('is-guide-focus');
      checker?.classList.remove('is-guided');
      checker?.classList.add('has-answer');
      document.getElementById('gf-hero-copy')?.classList.remove('is-guiding');
      if (checkerStatus) checkerStatus.textContent = 'Answer ready';
      updateReading();
      if (answerReading) answerReading.hidden = false;
      answerReading?.classList.remove('is-answer-ready');
      void answerReading?.offsetWidth;
      answerReading?.classList.add('is-answer-ready');
      answerReading?.scrollIntoView({ behavior:reducedMotion.matches ? 'auto' : 'smooth', block:'center' });
      if (resultStatus) resultStatus.textContent = 'Your planning estimate is ready.';
      window.setTimeout(() => title.focus({ preventScroll:true }), reducedMotion.matches ? 0 : 360);
    }

    function closeGuide() {
      guideStage = 0;
      if (guide) guide.hidden = true;
      taskField?.classList.remove('is-guide-focus');
      memoryField?.classList.remove('is-guide-focus');
      checker?.classList.remove('is-guided');
      document.getElementById('gf-hero-copy')?.classList.remove('is-guiding');
      if (checkerStatus) checkerStatus.textContent = '2 questions';
      startButton?.focus({ preventScroll:true });
    }

    function syncSubmit() {
      if (submitAnswer) submitAnswer.disabled = !task?.value;
    }

    function markAnswerStale() {
      if (!checker?.classList.contains('has-answer')) return;
      checker.classList.remove('has-answer');
      if (answerReading) answerReading.hidden = true;
      if (submitAnswer) submitAnswer.textContent = 'Update my starting point';
      if (checkerStatus) checkerStatus.textContent = 'Answer changed';
    }

    startButton?.addEventListener('click', startGuide);
    restartGuide?.addEventListener('click', () => {
      if (task) task.value = '';
      syncSubmit();
      startGuide();
    });
    guideClose?.addEventListener('click', closeGuide);
    guideNext?.addEventListener('click', () => {
      if (guideStage === 1) {
        if (!task?.value) { task?.focus(); return; }
        setGuideStage(2);
      } else finishGuide();
    });
    checker?.addEventListener('submit', event => { event.preventDefault(); finishGuide(); });
    task?.addEventListener('change', () => {
      markAnswerStale();
      updateReading();
      syncSubmit();
      if (guideStage === 1) setGuideStage(2);
    });
    memory?.addEventListener('change', () => {
      markAnswerStale();
      if (customWrap) customWrap.hidden = memory.value !== 'custom';
      if (memory.value === 'custom') customMemory?.focus();
      updateReading();
    });
    customMemory?.addEventListener('input', () => {
      markAnswerStale();
      updateReading();
      if (guideStage === 2 && Number(customMemory.value) >= 8) guideNext!.textContent = 'Show my answer';
    });
    syncSubmit();
    updateReading();
  </script>
</Base>
