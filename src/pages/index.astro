              <rect x="4" y="143" width="222" height="28" rx="4" fill="url(#baseB)" stroke="#333335" stroke-width="0.6"/>
              <rect x="10" y="147" width="210" height="20" rx="2" fill="#161618"/>
              <g fill="#232325" stroke="#2e2e30" stroke-width="0.4">
                <rect x="14"  y="149" width="12" height="5" rx="1"/>
                <rect x="28"  y="149" width="12" height="5" rx="1"/>
                <rect x="42"  y="149" width="12" height="5" rx="1"/>
                <rect x="56"  y="149" width="12" height="5" rx="1"/>
                <rect x="72"  y="149" width="12" height="5" rx="1"/>
