  <script define:vars={{ industriesForStage }}>
    const tabs  = document.querySelectorAll('.sm-tab');
    const card  = document.getElementById('sm-card');
    let active  = 0;

    function render(idx) {
      const d = industriesForStage[idx];
      card.style.animation = 'none';
      card.offsetHeight; // reflow
      card.style.animation = 'sm-stage-in 0.26s cubic-bezier(0.22,1,0.36,1) forwards';
      card.innerHTML = `
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:20px;">
          <div>
            <p style="font-family:'JetBrains Mono',monospace;font-size:0.58rem;letter-spacing:0.18em;text-transform:uppercase;color:#9b5de5;margin-bottom:8px;">${d.icon} · ${d.shortName}</p>
            <h3 style="font-family:'Fraunces',Georgia,serif;font-size:1.4rem;font-weight:700;color:#e5e5ea;line-height:1.2;letter-spacing:-0.01em;">${d.name}</h3>
          </div>
          <a href="/industries/${d.slug}" style="font-family:'JetBrains Mono',monospace;font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:#9b5de5;text-decoration:none;white-space:nowrap;padding-top:4px;flex-shrink:0;">Full guide →</a>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
          <div>
            <p style="font-family:'JetBrains Mono',monospace;font-size:0.55rem;letter-spacing:0.16em;text-transform:uppercase;color:#6e6e73;margin-bottom:10px;">Why local</p>
            <p style="font-size:0.85rem;color:#a1a1a6;line-height:1.65;">${d.whyLocal}</p>
          </div>
          <div>
            <p style="font-family:'JetBrains Mono',monospace;font-size:0.55rem;letter-spacing:0.16em;text-transform:uppercase;color:#6e6e73;margin-bottom:10px;">Common use cases</p>
            <ul style="list-style:none;display:flex;flex-direction:column;gap:6px;">
              ${d.commonUseCases.slice(0,5).map(u => `
                <li style="display:flex;align-items:flex-start;gap:8px;font-size:0.82rem;color:#a1a1a6;line-height:1.45;">
                  <span style="color:#9b5de5;margin-top:2px;flex-shrink:0;">·</span>${u}
                </li>`).join('')}
            </ul>
            <div style="margin-top:16px;display:flex;flex-wrap:wrap;gap:5px;">
              ${d.regulation.slice(0,3).map(r => `<span style="font-family:'JetBrains Mono',monospace;font-size:0.55rem;padding:2px 8px;border-radius:4px;background:rgba(155,93,229,0.08);border:1px solid rgba(155,93,229,0.2);color:#9b5de5;">${r}</span>`).join('')}
              ${d.regulation.length > 3 ? `<span style="font-family:'JetBrains Mono',monospace;font-size:0.55rem;padding:2px 8px;border-radius:4px;background:rgba(155,93,229,0.08);border:1px solid rgba(155,93,229,0.2);color:#9b5de5;">+${d.regulation.length - 3}</span>` : ''}
            </div>
          </div>
        </div>

        ${d.maturityNote ? `
        <div style="margin-top:20px;padding-top:18px;border-top:1px solid #1e1e22;">
          <p style="font-family:'JetBrains Mono',monospace;font-size:0.55rem;letter-spacing:0.16em;text-transform:uppercase;color:#6e6e73;margin-bottom:6px;">Maturity note</p>
          <p style="font-size:0.78rem;color:#6e6e73;line-height:1.6;font-style:italic;">${d.maturityNote}</p>
        </div>` : ''}
      `;
    }

    function setActive(idx) {
      tabs.forEach((t, i) => {
        const isActive = i === idx;
        t.style.borderColor = isActive ? '#9b5de5' : '#2a2a2d';
        t.style.background  = isActive ? 'rgba(155,93,229,0.12)' : 'rgba(255,255,255,0.02)';
        const dot = t.querySelector('.sm-pulse-dot');
        if (dot) dot.style.display = isActive ? 'block' : 'none';
        const spans = t.querySelectorAll('span:not(.sm-pulse-dot)');
        spans.forEach((s, si) => {
          const isExpCount = si === spans.length - 1 && industriesForStage[i].experimentCount > 0;
          s.style.color = isExpCount ? '#424245' : (isActive ? '#9b5de5' : (si === 0 ? '#6e6e73' : '#a1a1a6'));
        });
      });
      active = idx;
      render(idx);
    }

    tabs.forEach((t, i) => t.addEventListener('click', () => setActive(i)));

    // init
    render(0);
  </script>


  <!-- ═══ FAQ — decomposition coverage + FAQPage schema ═══ -->
