---
import Base from '../layouts/Base.astro';
import { dataset, breadcrumb } from '../lib/seo';
import {
  fetchOpenSourceModels,
  STATIC_OPEN_SOURCE_MODELS,
  USE_CASE_RECS,
  CLOSED_SOURCE_REFERENCE,
  TASK_SCORES,
  TIERS,
  getTier,
} from '../lib/artificialanalysis';

function getRamLabel(gb: number | null): { text: string; color: string; bg: string; border: string } {
  if (gb === null) return { text: ', ', color: '#6e6e73', bg: 'transparent', border: 'transparent' };
  if (gb <= 16)  return { text: `${gb} GB`,  color: '#34d399', bg: 'rgba(52,211,153,0.10)',  border: 'rgba(52,211,153,0.25)' };
  if (gb <= 36)  return { text: `${gb} GB`,  color: '#34d399', bg: 'rgba(52,211,153,0.10)',  border: 'rgba(52,211,153,0.25)' };
  if (gb <= 64)  return { text: `${gb} GB`,  color: '#60a5fa', bg: 'rgba(96,165,250,0.10)',  border: 'rgba(96,165,250,0.25)' };
  if (gb <= 128) return { text: `${gb} GB`,  color: '#a78bfa', bg: 'rgba(167,139,250,0.12)', border: 'rgba(167,139,250,0.3)'  };
  if (gb <= 244) return { text: `${gb} GB`,  color: '#4cc9f0', bg: 'rgba(76,201,240,0.10)',  border: 'rgba(76,201,240,0.25)' };
  return           { text: `${gb} GB`,       color: '#fb923c', bg: 'rgba(251,146,60,0.10)',  border: 'rgba(251,146,60,0.25)' };
}

const liveModels = await fetchOpenSourceModels();
// Always display in descending Intelligence Index order — slice(0,6) and the table render in
// array order, so sort here rather than relying on the static array being hand-ordered.
const openModels = (liveModels.length > 0 ? liveModels : STATIC_OPEN_SOURCE_MODELS)
  .slice()
  .sort((a, b) => (b.intelligenceIndex ?? 0) - (a.intelligenceIndex ?? 0));
const isLive = liveModels.length > 0;

// Use-case picks
const picks = USE_CASE_RECS.map(rec => ({
  ...rec,
  model: rec.pickFn(openModels),
})).filter(p => p.model !== undefined);

// Head-to-head task table rows: interleave open + closed sorted by each task score
const TASKS = [
  { key: 'swe',       label: 'SWE',      description: 'Code generation, bug fixes, refactoring' },
  { key: 'agentic',   label: 'Agentic',  description: 'Multi-step planning, tool use, function calling' },
  { key: 'reasoning', label: 'Reasoning',description: 'Chain-of-thought, math, auditable logic' },
  { key: 'general',   label: 'General',  description: 'Overall quality across mixed tasks' },
];

// Build unified ranked list per task
const TOP_OPEN_MODELS = openModels.slice(0, 6); // top 6 from leaderboard

function taskRows(taskKey: string) {
  type Row = { name: string; provider: string; score: number; isOpen: boolean; note?: string };
  const rows: Row[] = [];

  for (const m of TOP_OPEN_MODELS) {
    const s = TASK_SCORES[m.name]?.[taskKey];
    if (s !== undefined) rows.push({ name: m.name, provider: m.provider, score: s, isOpen: true });
  }
  for (const m of CLOSED_SOURCE_REFERENCE) {
    const s = TASK_SCORES[m.name]?.[taskKey];
    if (s !== undefined) rows.push({ name: m.name, provider: m.provider, score: s, isOpen: false, note: m.note });
  }

  return rows.sort((a, b) => b.score - a.score);
}

const buildDate = new Date().toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<Base
  title="Open-Source vs Closed, Model Rankings by Task"
  description="Head-to-head: open-weight vs closed models on SWE, agentic, reasoning, clinical, legal. Which open model competes with GPT-4.1? Rebuilt every 12 hours from artificialanalysis.ai."
  schema={[
    dataset({ site: Astro.site, path: '/models', name: 'Open-weight LLM leaderboard by task', description: 'Open-weight vs closed model rankings across coding, agentic, reasoning, clinical, and legal tasks, with minimum RAM and tokens/sec for Apple Silicon. Refreshed from artificialanalysis.ai.' }),
    breadcrumb(Astro.site, [{ name: 'Models', path: '/models' }]),
  ]}
>

  <div class="page-aurora">
    <div class="page-aurora-glow" style="background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(155,93,229,0.25) 0%, transparent 70%);"></div>
    <div class="max-w-wide mx-auto px-5 md:px-10 pt-24 pb-20 relative">
      <p class="font-mono text-[0.7rem] tracking-[0.2em] uppercase mb-4" style="color:#9b5de5;">Models</p>
      <h1 class="font-display font-semibold tracking-tight text-chalk reveal"
          style="font-size:clamp(2.4rem,5vw,3.75rem);line-height:1.06;">
        Open vs closed.<br />Which task. Which model.
      </h1>
      <p class="text-silver mt-5 max-w-xl leading-relaxed reveal">
        We rank open-weight models next to their closed-source counterparts, by task.
        SWE is not agentic. Agentic is not reasoning. The picks update automatically
        from artificialanalysis.ai every 12 hours.
      </p>
    </div>
  </div>

  <div class="max-w-wide mx-auto px-5 md:px-10 py-16">

    <!-- Source badge -->
    <div class="flex items-center gap-3 mb-14 reveal">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-mono"
            style="background:rgba(155,93,229,0.12); border:1px solid rgba(155,93,229,0.3); color:#9b5de5;">
        {isLive ? '● Live data' : '● Static snapshot · June 2026'}
      </span>
      <span class="text-xs text-ash">Source: artificialanalysis.ai · Built {buildDate}</span>
    </div>

    <!-- Head-to-head by task -->
    <section class="mb-20">
      <h2 class="font-display text-2xl font-semibold text-chalk mb-2 reveal">Head-to-head by task</h2>
      <p class="text-silver text-sm mb-3 reveal">
        Purple rows are open-weight, grey are closed APIs. The closed scores are here for scale only. Using them means your data leaves the building.
      </p>
      <p class="text-xs text-ash mb-10 reveal inline-flex items-center gap-2">
        Scores are on a 0–100 scale (Artificial Analysis Intelligence Index).
        <span class="info-tip" style="display:inline-flex;">
          <span class="info-tip-icon">i</span>
          <span class="info-tip-body">
            <strong style="color:#e5e5ea; display:block; margin-bottom:6px;">Why are scores only 40–60?</strong>
            The 0–100 scale is based on benchmarks so hard that no AI has scored above 60 yet. Today's world record is Claude Fable 5 at 60 (currently unavailable); the top available model is Claude Opus 4.8 at 56.<br /><br />
            These benchmarks are designed to find failure modes, not measure everyday capability:<br /><br />
            <span style="color:#e5e5ea;">· Humanity's Last Exam</span>, expert-contributed questions specifically designed to stump AI<br />
            <span style="color:#e5e5ea;">· GPQA Diamond</span>, PhD-level science problems<br />
            <span style="color:#e5e5ea;">· SciCode</span>, write research-grade scientific code<br />
            <span style="color:#e5e5ea;">· Terminal-Bench Hard</span>, shell commands that actually run<br /><br />
            For everyday tasks, writing, summarizing, drafting docs, models perform far better than these scores suggest. The benchmarks exist to reveal what's still broken, not what already works.
          </span>
        </span>
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {TASKS.map(task => {
          const rows = taskRows(task.key);
          const maxScore = rows[0]?.score ?? 100;
          return (
            <div class="reveal" style="border:1px solid #424245; border-radius:12px; overflow:hidden;">
              <div class="px-5 py-4" style="border-bottom:1px solid #424245; background:rgba(255,255,255,0.02);">
                <p class="font-display font-semibold text-chalk">{task.label}</p>
                <p class="text-xs text-ash mt-0.5">{task.description}</p>
              </div>
              <div class="p-5 flex flex-col gap-3">
                {rows.map((row, i) => (
                  <div>
                    <div class="flex items-center justify-between mb-1">
                      <div class="flex items-center gap-2">
                        <span class="font-mono text-[0.6rem] text-ash w-4 text-right">{i + 1}</span>
                        <div>
                          <span class={`text-sm font-medium ${row.isOpen ? 'text-chalk' : 'text-ash'}`}>
                            {row.name}
                          </span>
                          {row.isOpen && (
                            <span class="ml-2 text-[0.6rem] font-mono px-1.5 py-0.5 rounded"
                                  style="background:rgba(155,93,229,0.15); color:#9b5de5; border:1px solid rgba(155,93,229,0.25);">
                              open
                            </span>
                          )}
                          {!row.isOpen && (
                            <span class="ml-2 text-[0.6rem] font-mono px-1.5 py-0.5 rounded"
                                  style="background:rgba(255,255,255,0.05); color:#6e6e73; border:1px solid #2a2a2d;">
                              API only
                            </span>
                          )}
                        </div>
                      </div>
                      <span class="font-mono text-sm font-medium"
                            style={row.isOpen ? 'color:#9b5de5;' : 'color:#6e6e73;'}>
                        {row.score}
                      </span>
                    </div>
                    <!-- Score bar -->
                    <div class="ml-6 h-1 rounded-full" style="background:#2a2a2d;">
                      <div
                        class="h-1 rounded-full"
                        style={`width:${(row.score / maxScore) * 100}%; background:${row.isOpen ? '#9b5de5' : '#424245'};`}
                      ></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <p class="mt-6 text-xs text-ash leading-relaxed reveal">
        These scores approximate task-specific benchmarks from artificialanalysis.ai (SWEbench, GPQA, MMLU-Pro, and coding evals).
        Closed-source models are shown for scale only: they require API keys and route your data through third-party servers.
        Open-weight models run 100% on your hardware.
      </p>
    </section>

    <!-- Use-case picks -->
    <section class="mb-20">
      <h2 class="font-display text-2xl font-semibold text-chalk mb-2 reveal">Best open-weight pick per use case</h2>
      <p class="text-silver text-sm mb-10 reveal">
        Picked algorithmically from live leaderboard scores, not my opinion, not a static list.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {picks.map((pick, i) => (
          <div
            class="glow-card reveal"
            style={`animation-delay:${i * 60}ms; border:1px solid #424245; border-radius:12px; padding:1.5rem; position:relative; overflow:hidden;`}
          >
            <div class="flex items-start gap-3 mb-4">
              <span class="font-mono text-lg leading-none" style="color:#9b5de5;">{pick.icon}</span>
              <div>
                <p class="font-mono text-xs tracking-widest uppercase text-ash">{pick.label}</p>
                <p class="text-xs text-ash/70 mt-1 leading-relaxed">{pick.description}</p>
              </div>
            </div>

            <p class="font-display text-lg font-semibold text-chalk">{pick.model!.name}</p>
            <p class="text-xs text-ash mt-0.5 mb-4">{pick.model!.provider}</p>

            <div class="flex flex-wrap gap-2 mb-4">
              {pick.model!.intelligenceIndex !== null && (
                <span class="px-2 py-0.5 rounded text-xs font-mono"
                      style="background:rgba(155,93,229,0.12); color:#9b5de5; border:1px solid rgba(155,93,229,0.25);">
                  Intelligence {pick.model!.intelligenceIndex}
                </span>
              )}
              {pick.model!.codingScore !== null && (
                <span class="px-2 py-0.5 rounded text-xs font-mono"
                      style="background:rgba(255,255,255,0.05); color:#a1a1a6; border:1px solid #424245;">
                  Code {pick.model!.codingScore}
                </span>
              )}
              {pick.model!.mathScore !== null && (
                <span class="px-2 py-0.5 rounded text-xs font-mono"
                      style="background:rgba(255,255,255,0.05); color:#a1a1a6; border:1px solid #424245;">
                  Math {pick.model!.mathScore}
                </span>
              )}
              {pick.model!.outputSpeed !== null && (
                <span class="px-2 py-0.5 rounded text-xs font-mono"
                      style="background:rgba(255,255,255,0.05); color:#a1a1a6; border:1px solid #424245;">
                  {pick.model!.outputSpeed} t/s
                </span>
              )}
            </div>

            <p class="text-xs text-silver leading-relaxed border-t pt-4" style="border-color:#2a2a2d;">
              {pick.why(pick.model!)}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Full open-weight leaderboard -->
    <section>
      <h2 class="font-display text-2xl font-semibold text-chalk mb-2 reveal">Full open-weight leaderboard</h2>
      <p class="text-silver text-sm mb-2 reveal flex items-center gap-2 flex-wrap">
        Models marked <span class="font-mono text-[0.6rem] px-1.5 py-0.5 rounded"
          style="color:#4cc9f0;background:rgba(76,201,240,0.1);border:1px solid rgba(76,201,240,0.25);">RDMA cluster</span>
        require the TB5 two-node configuration (244 GB usable). All others run on a single machine.
      </p>
      <p class="text-silver text-sm mb-8 reveal flex items-center gap-2 flex-wrap">
        Ranked by overall intelligence index (0–100 scale).
        <span class="info-tip">
          <span class="info-tip-icon">i</span>
          <span class="info-tip-body">
            <strong style="color:#e5e5ea; display:block; margin-bottom:6px;">Why do scores look so low?</strong>
            This is a <strong style="color:#9b5de5;">0–100 scale</strong>, but no AI has scored above 60 yet. The benchmarks are intentionally brutal:<br /><br />
            <span style="color:#e5e5ea;">· Humanity's Last Exam</span>, questions designed to stump AI<br />
            <span style="color:#e5e5ea;">· GPQA Diamond</span>, PhD-level biology, chemistry, physics<br />
            <span style="color:#e5e5ea;">· SciCode</span>, research-grade scientific code<br />
            <span style="color:#e5e5ea;">· Terminal-Bench Hard</span>, shell tasks that actually execute<br /><br />
            A score of <strong style="color:#9b5de5;">54</strong> means 54% of that extremely hard mix. By contrast, a poem request would score 99. Expand the tier legend below to see what each score range means in practice.
          </span>
        </span>
        All models run locally, no API required.
      </p>

      <div class="overflow-x-auto reveal" style="border:1px solid #424245; border-radius:12px;">
        <table class="w-full text-sm">
          <thead>
            <tr style="border-bottom:1px solid #424245; background:rgba(255,255,255,0.02);">
              <th class="text-left px-5 py-4 font-mono text-[0.65rem] tracking-widest uppercase text-ash">#</th>
              <th class="text-left px-5 py-4 font-mono text-[0.65rem] tracking-widest uppercase text-ash">Model</th>
              <th class="text-left px-5 py-4 font-mono text-[0.65rem] tracking-widest uppercase text-ash">Provider</th>
              <th class="text-right px-5 py-4 font-mono text-[0.65rem] tracking-widest uppercase text-ash">Intelligence</th>
              <th class="text-right px-5 py-4 font-mono text-[0.65rem] tracking-widest uppercase text-ash">Coding</th>
              <th class="text-right px-5 py-4 font-mono text-[0.65rem] tracking-widest uppercase text-ash">Math</th>
              <th class="text-right px-5 py-4 font-mono text-[0.65rem] tracking-widest uppercase text-ash">Speed (t/s)</th>
              <th class="text-right px-5 py-4 font-mono text-[0.65rem] tracking-widest uppercase text-ash">Context</th>
              <th class="text-right px-5 py-4 font-mono text-[0.65rem] tracking-widest uppercase text-ash">Min RAM</th>
              <th class="text-left px-5 py-4 font-mono text-[0.65rem] tracking-widest uppercase text-ash">Level</th>
            </tr>
          </thead>
          <tbody>
            {openModels.map((m, i) => {
              const tier = getTier(m.intelligenceIndex);
              const ram = getRamLabel(m.minRamGb);
              return (
                <tr style="border-bottom:1px solid #2a2a2d; transition:background 0.15s;"
                    class="hover:bg-white/[0.02]">
                  <td class="px-5 py-4 font-mono text-ash text-xs">{i + 1}</td>
                  <td class="px-5 py-4 font-medium">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="text-chalk">{m.name}</span>
                      {m.requiresCluster && (
                        <span class="info-tip">
                          <span class="font-mono text-[0.55rem] px-1.5 py-0.5 rounded cursor-default"
                                style="color:#4cc9f0;background:rgba(76,201,240,0.1);border:1px solid rgba(76,201,240,0.25);">
                            RDMA cluster
                          </span>
                          <span class="info-tip-body" style="left:0;transform:none;">
                            <strong style="color:#4cc9f0;display:block;margin-bottom:6px;">TB5 RDMA cluster required</strong>
                            {m.clusterNote}<br /><br />
                            <span style="color:#e5e5ea;">Setup:</span> Two MacBook Pro M5 Max 128 GB nodes connected via Thunderbolt 5 RDMA. Set Metal heap manually to leave 12 GB overhead (244 GB usable). ~800 GB/s inter-node bandwidth at ~3 µs latency.
                          </span>
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="px-5 py-4 text-silver">{m.provider}</td>
                  <td class="px-5 py-4 text-right font-mono font-medium" style="color:#9b5de5;">
                    {m.intelligenceIndex ?? ', '}
                  </td>
                  <td class="px-5 py-4 text-right font-mono text-silver">{m.codingScore ?? ', '}</td>
                  <td class="px-5 py-4 text-right font-mono text-silver">{m.mathScore ?? ', '}</td>
                  <td class="px-5 py-4 text-right font-mono text-silver">{m.outputSpeed ?? ', '}</td>
                  <td class="px-5 py-4 text-right font-mono text-ash text-xs">
                    {m.contextWindow ? `${(m.contextWindow / 1000).toFixed(0)}K` : ', '}
                  </td>
                  <td class="px-5 py-4 text-right">
                    {m.minRamGb !== null ? (
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-[0.6rem] font-mono whitespace-nowrap"
                            style={`color:${ram.color}; background:${ram.bg}; border:1px solid ${ram.border};`}>
                        {ram.text}
                      </span>
                    ) : (
                      <span class="font-mono text-xs text-ash">, </span>
                    )}
                  </td>
                  <td class="px-5 py-4">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[0.6rem] font-mono whitespace-nowrap"
                          style={`color:${tier.accent}; background:${tier.bg}; border:1px solid ${tier.border};`}>
                      {tier.shortLabel}
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <!-- RAM tier legend -->
      <div class="mt-5 mb-3 flex flex-wrap gap-3 items-center reveal">
        <span class="text-[0.65rem] font-mono text-ash uppercase tracking-widest">Min RAM:</span>
        <span class="inline-flex items-center gap-1.5 text-[0.65rem] font-mono" style="color:#34d399;">
          <span class="w-2 h-2 rounded-full inline-block" style="background:#34d399;"></span> ≤ 36 GB, any M4/M5
        </span>
        <span class="inline-flex items-center gap-1.5 text-[0.65rem] font-mono" style="color:#60a5fa;">
          <span class="w-2 h-2 rounded-full inline-block" style="background:#60a5fa;"></span> 37–64 GB, M4/M5 Pro 48 GB+
        </span>
        <span class="inline-flex items-center gap-1.5 text-[0.65rem] font-mono" style="color:#a78bfa;">
          <span class="w-2 h-2 rounded-full inline-block" style="background:#a78bfa;"></span> 65–128 GB, M5 Max 128 GB
        </span>
        <span class="inline-flex items-center gap-1.5 text-[0.65rem] font-mono" style="color:#4cc9f0;">
          <span class="w-2 h-2 rounded-full inline-block" style="background:#4cc9f0;"></span> 129–244 GB, RDMA cluster
        </span>
        <span class="inline-flex items-center gap-1.5 text-[0.65rem] font-mono" style="color:#fb923c;">
          <span class="w-2 h-2 rounded-full inline-block" style="background:#fb923c;"></span> &gt; 244 GB, bigger cluster needed
        </span>
      </div>
      <p class="mt-2 text-xs text-ash leading-relaxed reveal">
        Min RAM = minimum unified memory to run at Q3_K_M quantization (large MoE) or Q4_K_M (dense/small).
        Intelligence Index is artificialanalysis.ai's composite quality score (0–100 scale, AA Intelligence Index v4.1). Scores look low because the benchmarks are hard: Humanity's Last Exam, GPQA Diamond, SciCode, and 6 other graduate-level evals. The current world ceiling is Claude Fable 5 at 60 (currently unavailable; Claude Opus 4.8 at 56 is the top available model). A score of 51 means the model correctly handled 51% of that extremely difficult mix.
        All models have publicly released weights, no API key required to run them.
      </p>
    </section>

    <!-- Intelligence tier legend (collapsible) -->
    <details class="glow-card mt-12 reveal group" style="border-radius:12px; overflow:visible;">
      <summary class="flex items-center justify-between p-6 cursor-pointer list-none select-none">
        <div>
          <p class="font-mono text-[0.65rem] tracking-widest uppercase text-ash mb-1">Intelligence scale</p>
          <h2 class="font-display text-xl font-semibold text-chalk">What the scores actually mean</h2>
          <p class="text-silver text-xs mt-1">Each level mapped to real-world tasks, with concrete examples</p>
        </div>
        <span class="font-mono text-xs text-ash border border-wire rounded px-2 py-1 ml-6 shrink-0
                     group-open:text-chalk transition-colors">
          <span class="group-open:hidden">Expand ↓</span>
          <span class="hidden group-open:inline">Collapse ↑</span>
        </span>
      </summary>

      <div class="px-6 pb-8">
        <p class="text-silver text-sm mb-6 leading-relaxed">
          These aren't IQ comparisons: they're a shorthand for the kinds of tasks a model handles reliably.
          Real-world complexity, not exam performance.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {TIERS.map((tier) => (
            <div class="rounded-xl p-4" style={`background:${tier.bg}; border:1px solid ${tier.border};`}>
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-[0.6rem] font-semibold tracking-wider"
                      style={`color:${tier.accent};`}>
                  {tier.label}
                </span>
                <span class="font-mono text-[0.6rem] text-ash">
                  {tier.max >= 99 ? `${tier.min}+` : `${tier.min}–${tier.max}`}
                </span>
              </div>
              <p class="text-xs text-silver leading-relaxed mb-3">{tier.description}</p>
              <ul class="space-y-1.5">
                {tier.skills.map((skill) => (
                  <li class="text-[0.7rem] text-ash leading-snug flex gap-1.5">
                    <span style={`color:${tier.accent}; flex-shrink:0;`}>·</span>
                    <span>{skill}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <p class="mt-6 text-xs text-ash leading-relaxed">
          Closed-source reference: Claude Fable 5 scores 60 (PhD with distinction), the current world ceiling as of June 2026 (currently unavailable; Claude Opus 4.8 at 56 is the top available model).
          No model, open or closed, has reached the Frontier PhD tier (68+) yet.
        </p>
      </div>
    </details>

    <!-- Hardware CTA -->
    <div class="glow-card mt-16 reveal p-8">
      <p class="font-mono text-[0.65rem] tracking-widest uppercase text-ash mb-3">Next step</p>
      <h2 class="font-display text-xl font-semibold text-chalk mb-3">Which hardware runs the top models?</h2>
      <p class="text-silver text-sm leading-relaxed mb-5">
        The top models need 36–128 GB of unified memory to run. Our hardware guide covers what that means in practice, every Apple Silicon config, with prices.
      </p>
      <a href="/hardware"
         class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium text-chalk transition-all"
