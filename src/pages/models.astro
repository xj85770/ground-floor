---
import Base from '../layouts/Base.astro';
import { page, breadcrumb } from '../lib/seo';
import { modelExamples } from '../lib/explorer';
const schema=[page('WebPage',{site:Astro.site,path:'/models',name:'Open-weight model examples by size',description:'Publisher-sourced local model examples organized by parameter class—not a quality ranking.'}),breadcrumb(Astro.site,[{name:'Ground Floor',path:'/'},{name:'Model examples',path:'/models'}])];
---
<Base title="Open-weight model examples by size" description="Publisher-sourced local model examples organized by parameter class—not a quality ranking." appearance="light" schema={schema}>
  <header class="gf-page-hero"><div class="gf-shell"><p class="gf-eyebrow">Model reference</p><h1 class="gf-display mt-4">Real model examples—without a fake leaderboard.</h1><p class="gf-lede">These are publisher-verified model identities organized by parameter class. Ground Floor is not claiming they are “best,” fast on your Mac, or suitable for your work.</p><a class="gf-button inline-flex mt-7" href="/setup">Match models to my Mac</a></div></header>
  <section class="gf-content"><div class="gf-shell"><div class="gf-reference-table" role="table" aria-label="Open-weight model examples"><div class="gf-reference-row gf-model-reference-head" role="row"><span role="columnheader">Model</span><span role="columnheader">Class</span><span role="columnheader">Modality</span><span role="columnheader">License</span></div>{modelExamples.map(item=><a class="gf-reference-row gf-model-reference-row" role="row" href={item.source}><strong role="cell">{item.name}</strong><span role="cell">{item.size}B</span><span role="cell">{item.modality}</span><span role="cell">{item.license}</span></a>)}</div><div class="gf-boundary-grid mt-12"><div><h3>The model card establishes</h3><ul><li>Publisher identity and parameter class.</li><li>Stated modalities, context, and license.</li><li>Publisher usage guidance and limitations.</li></ul></div><div><h3>Your direct test must establish</h3><ul><li>The exact compatible quantized artifact.</li><li>Fit, speed, context, and stability on your build.</li><li>Quality and edit burden for your real task.</li></ul></div></div><p class="gf-source-line">Sources checked July 19, 2026. Every model name links directly to its publisher’s Hugging Face model card. Inclusion is an example—not an endorsement or ranking.</p></div></section>
</Base>
