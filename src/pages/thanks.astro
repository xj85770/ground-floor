---
import Base from '../layouts/Base.astro';
---
<Base title="Task received" description="Ground Floor received the field-test idea." appearance="light" noindex>
  <section class="gf-page-hero min-h-[58vh] flex items-center">
    <div class="gf-shell">
      <p class="gf-eyebrow">Received</p>
      <h1 class="gf-display mt-4">Thank you. The task is in.</h1>
      <p class="gf-lede mt-5">Ground Floor will review whether it is narrow, safe to test, and useful enough to measure.</p>
      <a class="gf-button mt-8" href="/">Return home</a>
    </div>
  </section>
</Base>
