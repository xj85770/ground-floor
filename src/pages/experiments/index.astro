---
import Base from '../../layouts/Base.astro';
import ExperimentCard from '../../components/ExperimentCard.astro';
import { getCollection } from 'astro:content';
import { page, breadcrumb } from '../../lib/seo';

const all = (await getCollection('experiments')).sort((a,b) => a.data.week - b.data.week);
const schema = [
  page('CollectionPage', { site: Astro.site, path: '/experiments', name: 'Ground Floor evidence and test protocols', description: 'Public evidence states and validation protocols for local AI documentation workflows.' }),
  breadcrumb(Astro.site, [{ name:'Ground Floor', path:'/' }, { name:'Evidence', path:'/experiments' }]),
];
---

<Base title="Evidence and test protocols" description="Public evidence states and validation protocols for local AI documentation workflows." appearance="light" schema={schema}>
  <header class="gf-page-hero">
    <div class="gf-shell">
      <p class="gf-eyebrow">Evidence</p>
      <h1 class="gf-display mt-4">What has Ground Floor actually tested?</h1>
      <p class="gf-lede">No regulated workflow currently meets the measured-evidence standard. The three items below are protocols: useful test designs with no completed outcome claimed.</p>
    </div>
  </header>

  <section class="gf-section gf-section-white">
    <div class="gf-shell gf-evidence-summary">
      <aside>
        <div class="gf-evidence-count"><strong>0</strong><span>Measured regulated workflows</span></div>
        <div class="mt-8 gf-copy text-[14px]">
          <p><strong>Measured</strong>: retained run artifacts and evaluation.</p>
          <p class="mt-3"><strong>Estimate</strong>: calculated from disclosed assumptions.</p>
          <p class="mt-3"><strong>Third-party</strong>: attributed external evidence.</p>
          <p class="mt-3"><strong>Protocol</strong>: a proposed test without a result.</p>
          <a class="gf-link inline-flex mt-5" href="/playbook">Read the testing method</a>
        </div>
      </aside>
      <div>
        <div class="gf-task-list">{all.map(item => <ExperimentCard experiment={item} />)}</div>
        <div class="mt-8 border border-[#d5dce0] p-5">
          <p class="gf-eyebrow text-[#a23b2a]">Correction record</p>
          <p class="gf-copy mt-2">An earlier contract-review draft named a Llama 3.1 model size that Meta did not release. The outcome was withdrawn and replaced with a protocol.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="gf-cta">
    <div class="gf-shell gf-cta-grid"><div><h2 class="gf-h2">Help turn one protocol into evidence.</h2><p class="gf-copy">Bring a repeatable documentation task and help define what “correct” means.</p></div><a class="gf-button" href="/pilot">Tell us the task</a></div>
  </section>
</Base>
